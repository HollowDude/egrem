---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductoFicha from '@/components/tienda/ProductoFicha.tsx';
import TiendaProductCard from '@/components/tienda/TiendaProductCard.astro';
import { fetchProductosMerchDetalle } from '@/lib/nodehive/comercio';
import { productoATiendaProducto } from '@/lib/tienda/productoAdapters';
import { useTranslations } from '@/i18n/translations';

const lang = Astro.locals.lang;
const tr = useTranslations(lang);

const slug = Astro.url.pathname
  .replace(/^\/?(?:es\/|en\/)?tienda\/producto\//, '')
  .replace(/\/$/, '');

// Catálogo real (Drupal). Sin fallback de ejemplo: si el slug no existe, 404.
const catalogo = await fetchProductosMerchDetalle(lang);
const producto = catalogo.find((p) => p.slug === slug) ?? null;
if (!producto) return Astro.rewrite('/404');

// Selección inicial desde query params (?color=&talla=) — continuidad listado→detalle.
const seleccionInicial = {
  color: Astro.url.searchParams.get('color') ?? undefined,
  talla: Astro.url.searchParams.get('talla') ?? undefined,
};

// Productos relacionados: misma categoría (tipo) reales, tope 4.
const resto = catalogo.filter((p) => p.slug !== producto.slug);
const mismaCategoria = resto.filter((p) => p.tipo === producto.tipo).slice(0, 4);
const relacionados = [
  ...mismaCategoria,
  ...resto.filter((p) => p.tipo !== producto.tipo).slice(0, Math.max(0, 4 - mismaCategoria.length)),
].map(productoATiendaProducto);

const pageTitle = `${producto.titulo} | EGREM`;
---

<BaseLayout title={pageTitle} description={producto.descripcion.slice(0, 160) || producto.titulo}>
  <main id="main-content" class="container-site py-8 md:py-12">
    {/* Breadcrumb */}
    <nav class="text-small font-display text-text-secondary mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 flex-wrap m-0 p-0 list-none">
        <li><a href="/" class="hover:text-egrem-red no-underline">Inicio</a></li>
        <li class="text-egrem-gray"><span class="icon" style="font-size:14px">chevron_right</span></li>
        <li><a href="/tienda" class="hover:text-egrem-red no-underline">{tr('tienda.product.breadcrumb_tienda')}</a></li>
        <li class="text-egrem-gray"><span class="icon" style="font-size:14px">chevron_right</span></li>
        <li><a href="/tienda" class="hover:text-egrem-red no-underline text-egrem-gold">{tr('tienda.product.breadcrumb_merchandising')}</a></li>
        <li class="text-egrem-gray"><span class="icon" style="font-size:14px">chevron_right</span></li>
        <li class="text-egrem-black font-bold" aria-current="page">{producto.titulo}</li>
      </ol>
    </nav>

    {/* Grid principal: ProductoFicha posee galería + selector (un solo island). */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-24 mb-24 md:items-start">
      <ProductoFicha producto={producto} lang={lang} seleccionInicial={seleccionInicial} client:load />
    </div>

    {/* Productos Relacionados */}
    <section class="mt-24 border-t border-egrem-gray-light pt-16">
      <div class="border-b-2 border-egrem-gold inline-flex pb-2 mb-8">
        <h2 class="text-h3 uppercase m-0">{tr('tienda.product.relacionados')}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5 lg:gap-6">
        {relacionados.map((p) => (
          <TiendaProductCard producto={p} lang={lang} mostrarCta={false} />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
