---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import TiendaSidebar from '@/components/tienda/TiendaSidebar.astro';
import TiendaPaginator from '@/components/tienda/TiendaPaginator.astro';
import EventoListCard from '@/components/evento/EventoListCard.astro';
import { fetchEventosListado, slugify } from '@/lib/nodehive';
import { applyFilters, paginate, type TiendaFilters, type TiendaSort } from '@/lib/tienda/filters';
import { useTranslations } from '@/i18n/translations';

const lang = Astro.locals.lang;
const tr = useTranslations(lang);
const basePath = Astro.url.pathname.split('?')[0];

const get = (k: string) => Astro.url.searchParams.get(k) ?? '';

const tipo = get('tipo');
const sede = get('sede');
const precioMin = get('precioMin');
const precioMax = get('precioMax');
const disponibilidad = get('disponibilidad');
const q = get('q');
const ordenParam = get('orden');
const orden: TiendaSort =
  ordenParam === 'precio-asc' || ordenParam === 'precio-desc' ? ordenParam : 'proximos';
const pagRaw = Number(get('pag')) || 1;
const pag = pagRaw > 0 ? Math.floor(pagRaw) : 1;

const filtros: TiendaFilters = { tipo, sede, precioMin, precioMax, disponibilidad, q };

const eventos = await fetchEventosListado(lang);

const tiposUnicos = new Map<string, string>();
const sedesUnicas = new Map<string, string>();
for (const e of eventos) {
  const ts = slugify(e.categoria);
  if (ts && !tiposUnicos.has(ts)) tiposUnicos.set(ts, e.categoria);
  const ss = slugify(e.lugarTexto);
  if (ss && !sedesUnicas.has(ss)) sedesUnicas.set(ss, e.lugarTexto);
}
const tipos = [...tiposUnicos]
  .map(([slug, label]) => ({ slug, label }))
  .sort((a, b) => a.label.localeCompare(b.label));

const chips = [{ slug: '', label: tr('tienda.filter.tipo.all') }, ...tipos];

function buildQuery(overrides: Record<string, string>): string {
  const params = new URLSearchParams();
  if (filtros.tipo) params.set('tipo', filtros.tipo);
  if (filtros.disponibilidad) params.set('disponibilidad', filtros.disponibilidad);
  if (filtros.precioMin) params.set('precioMin', filtros.precioMin);
  if (filtros.precioMax) params.set('precioMax', filtros.precioMax);
  if (filtros.q) params.set('q', filtros.q);
  if (orden && orden !== 'proximos') params.set('orden', orden);
  for (const [k, v] of Object.entries(overrides)) {
    if (v) params.set(k, v);
    else params.delete(k);
  }
  return `${basePath}?${params.toString()}`;
}

const aplicados = applyFilters(eventos, filtros, orden);
const { items, totalPages } = paginate(aplicados, pag, 9);
---

<BaseLayout title={tr('tienda.page_title')} description={tr('tienda.page_description')}>
  <main id="main-content" class="pb-20 px-4 md:px-16 max-w-container-max mx-auto">
    <!-- Chips de categoría -->
    <section class="pt-8 mb-8">
      <div class="flex items-center gap-2 flex-wrap">
        {chips.map((c) => (
          <a
            href={buildQuery({ tipo: c.slug })}
            class:list={['tienda-chip', filtros.tipo === c.slug ? 'tienda-chip--active' : '']}
          >
            <span class="material-symbols-outlined text-[15px]" style="font-family: 'Material Symbols Outlined';">
              {c.slug ? 'confirmation_number' : 'apps'}
            </span>
            {c.label}
          </a>
        ))}
      </div>
    </section>

    <div class="flex flex-col lg:flex-row gap-12">
      <!-- Sidebar -->
      <aside class="w-full lg:w-64 flex-shrink-0">
        <div class="lg:sticky lg:top-24">
          <TiendaSidebar {tipos} {filtros} {orden} {basePath} />
        </div>
      </aside>

      <!-- Grid de productos -->
      <div class="flex-grow">
        <div class="flex justify-between items-center mb-6 pb-4 border-b border-egrem-gray-light">
          <span class="font-display text-text-secondary" data-product-count>
            {tr('tienda.list.showing', { count: aplicados.length })}
          </span>
          <form method="GET" action={basePath} class="flex items-center gap-3">
            {tipo && <input type="hidden" name="tipo" value={tipo} />}
            {disponibilidad && <input type="hidden" name="disponibilidad" value={disponibilidad} />}
            {precioMin && <input type="hidden" name="precioMin" value={precioMin} />}
            {precioMax && <input type="hidden" name="precioMax" value={precioMax} />}
            {q && <input type="hidden" name="q" value={q} />}
            <span class="font-display text-text-secondary">{tr('tienda.filter.orden')}:</span>
            <select
              name="orden"
              class="bg-white border border-form-border text-egrem-black font-display py-1 pl-2 pr-8 rounded-xl focus:border-egrem-red focus:ring-1 focus:ring-egrem-red outline-none"
              onchange="this.form.submit()"
            >
              <option value="proximos" selected={orden === 'proximos'}>{tr('tienda.filter.orden.proximos')}</option>
              <option value="precio-asc" selected={orden === 'precio-asc'}>{tr('tienda.filter.orden.precio-asc')}</option>
              <option value="precio-desc" selected={orden === 'precio-desc'}>{tr('tienda.filter.orden.precio-desc')}</option>
            </select>
          </form>
        </div>

        {
          aplicados.length === 0 ? (
            <div class="empty-state">
              <span class="material-symbols-outlined text-5xl text-egrem-gray/40 mb-4" style="font-family: 'Material Symbols Outlined';">search_off</span>
              <p class="text-egrem-gray text-body m-0">
                {eventos.length === 0 ? tr('tienda.list.empty') : tr('tienda.list.no_results')}
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5 mb-12">
              {items.map((evento) => (
                <EventoListCard evento={evento} lang={lang} ctaLabel={tr('tienda.list.buy')} />
              ))}
            </div>
          )
        }

        <TiendaPaginator {basePath} {totalPages} currentPage={pag} {filtros} {orden} />
      </div>
    </div>
  </main>
</BaseLayout>
