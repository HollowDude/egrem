---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import TiendaCategoriaChips from '@/components/tienda/TiendaCategoriaChips.astro';
import TiendaSidebar from '@/components/tienda/TiendaSidebar.astro';
import TiendaProductCard from '@/components/tienda/TiendaProductCard.astro';
import { fetchEventosListado } from '@/lib/nodehive';
import { entradaToProducto } from '@/lib/tienda/entradas';
import { fetchProductosMerchDetalle } from '@/lib/nodehive/comercio';
import { productoATiendaProducto } from '@/lib/tienda/productoAdapters';
import { MERCH_API_REAL } from '@/types/producto';
import type { TiendaProducto } from '@/types/tienda';
import { useTranslations } from '@/i18n/translations';

const lang = Astro.locals.lang;
const tr = useTranslations(lang);

const entradas = (await fetchEventosListado(lang)).map(entradaToProducto);
const merchandising: TiendaProducto[] = MERCH_API_REAL
  ? (await fetchProductosMerchDetalle(lang)).map(productoATiendaProducto)
  : [];
const musica: TiendaProducto[] = [];
const productos: TiendaProducto[] = [...entradas, ...merchandising, ...musica];

const facetTallas = [...new Set(merchandising.flatMap((p) => p.tallas ?? []))].sort();
const facetColores = [...new Set(merchandising.flatMap((p) => p.colores ?? []))].sort();
---

<BaseLayout title={tr('tienda.page_title')} description={tr('tienda.page_description')}>
  <main id="main-content" class="pb-20 px-4 md:px-16 max-w-container-max mx-auto">
    <!-- Hero -->
    <section class="pt-14 pb-10 border-b border-egrem-gray-light">
      <span class="eyebrow">{tr('tienda.hero.eyebrow')}</span>
      <h1 class="text-h1 text-egrem-black m-0 mt-1">{tr('tienda.hero.title')}</h1>
      <p class="font-display text-body text-text-secondary mt-4 max-w-2xl">
        {tr('tienda.hero.subtitle')}
      </p>
    </section>

    <!-- Chips de categoría -->
    <section class="mb-8">
      <TiendaCategoriaChips />
    </section>

    <div class="flex flex-col lg:flex-row gap-12">
      <!-- Sidebar -->
      <TiendaSidebar tallas={facetTallas} colores={facetColores} />

      <!-- Grid de productos -->
      <div class="flex-grow">
        <div class="flex justify-between items-center mb-6 pb-4 border-b border-egrem-gray-light">
          <span class="font-display text-text-secondary" data-product-count>
            {tr('tienda.list.showing', { count: productos.length })}
          </span>
          <div class="flex items-center gap-3">
            <span class="font-display text-text-secondary">{tr('tienda.filter.orden')}:</span>
            <select
              data-tienda-sort
              class="bg-white border border-form-border text-egrem-black font-display py-1 pl-2 pr-8 rounded-xl focus:border-egrem-red focus:ring-1 focus:ring-egrem-red outline-none"
            >
              <option value="recomendados">{tr('tienda.sort.recomendados')}</option>
              <option value="novedades">{tr('tienda.sort.novedades')}</option>
              <option value="precio-asc">{tr('tienda.filter.orden.precio-asc')}</option>
              <option value="precio-desc">{tr('tienda.filter.orden.precio-desc')}</option>
            </select>
          </div>
        </div>

        <div
          id="product-grid"
          class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-6 mb-12"
        >
          {
            productos.map((p) => (
              <TiendaProductCard
                producto={p}
                lang={lang}
                ctaLabel={tr('tienda.list.buy')}
                mostrarCta={p.categoria === 'merchandising'}
              />
            ))
          }
        </div>

        <div id="tienda-pagination" class="flex justify-center items-center gap-2 mb-12"></div>

        <div id="tienda-empty" class="empty-state hidden">
          <span class="icon text-5xl text-egrem-gray/40 mb-4">search_off</span>
          <p class="text-egrem-gray text-body m-0">{tr('tienda.list.no_results')}</p>
        </div>
      </div>
    </div>
  </main>

  <script>
    const grid = document.getElementById('product-grid');
    const countEl = document.querySelector('[data-product-count]');
    const pagEl = document.getElementById('tienda-pagination');
    const emptyEl = document.getElementById('tienda-empty');
    const sidebar = document.querySelector('[data-tienda-sidebar]');
    const chipsWrap = document.querySelector('[data-cat-chips]');
    if (grid && sidebar && chipsWrap && countEl && pagEl && emptyEl) {
      const cards = Array.from(grid.querySelectorAll('[data-category]')) as HTMLElement[];
      const PAGE_SIZE = 9;
      const isEn = document.documentElement.lang && document.documentElement.lang.startsWith('en');

      const state = {
        chip: '',
        maxPrice: 200,
        avail: new Set(),
        tallas: new Set(),
        colores: new Set(),
        query: '',
        sort: 'recomendados',
        page: 1,
      };

      const priceLabel = sidebar.querySelector('[data-tienda-price-label]');
      const priceInput = sidebar.querySelector('[data-tienda-price]') as HTMLInputElement | null;

      const matches = (c: HTMLElement) => {
        const cat = c.dataset.category || '';
        const chipOk = state.chip === '' || cat === state.chip;
        if (!chipOk) return false;

        const price = c.dataset.price || '';
        if (price !== '' && parseFloat(price) > state.maxPrice) return false;

        if (state.avail.size > 0 && !state.avail.has(c.dataset.availability || '')) return false;

        if (state.tallas.size > 0) {
          const ts = (c.dataset.tallas || '').split(',').filter(Boolean);
          if (!ts.some((t) => state.tallas.has(t))) return false;
        }
        if (state.colores.size > 0) {
          const cs = (c.dataset.colores || '').split(',').filter(Boolean);
          if (!cs.some((col) => state.colores.has(col))) return false;
        }

        if (state.query) {
          const hay = `${c.dataset.title || ''} ${c.dataset.subtitle || ''}`.toLowerCase();
          if (!hay.includes(state.query)) return false;
        }
        return true;
      };

      const sortCards = (list: HTMLElement[]) => {
        const arr = list.slice();
        if (state.sort === 'precio-asc') {
          arr.sort(
            (a, b) =>
              parseFloat(a.dataset.price || 'Infinity') - parseFloat(b.dataset.price || 'Infinity'),
          );
        } else if (state.sort === 'precio-desc') {
          arr.sort(
            (a, b) => parseFloat(b.dataset.price || '-1') - parseFloat(a.dataset.price || '-1'),
          );
        } else if (state.sort === 'novedades') {
          arr.sort(
            (a, b) => parseInt(b.dataset.novedad || '0') - parseInt(a.dataset.novedad || '0'),
          );
        }
        return arr;
      };

      const render = () => {
        const filtered = sortCards(cards.filter(matches));
        const total = filtered.length;
        const visible = filtered.slice((state.page - 1) * PAGE_SIZE, state.page * PAGE_SIZE);

        cards.forEach((c) => (c.style.display = 'none'));
        visible.forEach((c) => (c.style.display = ''));

        countEl.textContent = isEn
          ? `Showing ${total} product${total === 1 ? '' : 's'}`
          : `Mostrando ${total} producto${total === 1 ? '' : 's'}`;
        emptyEl.classList.toggle('hidden', total !== 0);
        grid.classList.toggle('hidden', total === 0);

        // Filtros dinámicos de merchandising solo en esa categoría (o "Todos").
        const showMerchFilters = state.chip === '' || state.chip === 'merchandising';
        (
          sidebar.querySelectorAll('[data-tienda-filter-group]') as unknown as HTMLElement[]
        ).forEach((g) => {
          const grupoOk = g.dataset.tiendaFilterGroup === 'merchandising' && showMerchFilters;
          g.classList.toggle('hidden', !grupoOk);
        });

        renderPagination(total);
      };

      const renderPagination = (total: number) => {
        const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
        if (totalPages <= 1) {
          pagEl.innerHTML = '';
          return;
        }
        if (state.page > totalPages) state.page = totalPages;

        const btn = (
          label: string,
          page: number,
          opts?: { active?: boolean; disabled?: boolean },
        ) => {
          opts = opts || {};
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = label;
          b.className = [
            'w-10 h-10 flex items-center justify-center border font-display font-bold rounded-2xl transition-colors',
            opts.active
              ? 'border-egrem-red bg-egrem-red text-white'
              : 'border-form-border text-egrem-black hover:border-egrem-red hover:text-egrem-red',
          ].join(' ');
          if (opts.disabled) b.setAttribute('disabled', 'true');
          else
            b.addEventListener('click', () => {
              state.page = page;
              render();
            });
          return b;
        };

        pagEl.innerHTML = '';
        const prev = btn('', Math.max(1, state.page - 1), { disabled: state.page === 1 });
        prev.innerHTML = '<span class="icon text-sm">chevron_left</span>';
        prev.addEventListener('click', () => {
          if (state.page > 1) {
            state.page--;
            render();
          }
        });
        pagEl.appendChild(prev);

        for (let p = 1; p <= totalPages; p++) {
          pagEl.appendChild(btn(String(p), p, { active: p === state.page }));
        }

        const next = btn('', Math.min(totalPages, state.page + 1), {
          disabled: state.page === totalPages,
        });
        next.innerHTML = '<span class="icon text-sm">chevron_right</span>';
        next.addEventListener('click', () => {
          if (state.page < totalPages) {
            state.page++;
            render();
          }
        });
        pagEl.appendChild(next);
      };

      // ── Chips ──
      (chipsWrap.querySelectorAll('[data-filter]') as unknown as HTMLElement[]).forEach((chip) => {
        chip.addEventListener('click', () => {
          state.chip = chip.dataset.filter || '';
          state.page = 1;
          (chipsWrap.querySelectorAll('[data-filter]') as unknown as HTMLElement[]).forEach((c) => {
            const active = c === chip;
            c.classList.toggle('tienda-chip--active', active);
            c.setAttribute('aria-pressed', String(active));
          });
          render();
        });
      });

      // ── Sidebar: búsqueda ──
      const search = sidebar.querySelector('[data-tienda-search]') as HTMLInputElement | null;
      if (search) {
        search.addEventListener('input', () => {
          state.query = (search.value || '').toLowerCase().trim();
          state.page = 1;
          render();
        });
      }

      // ── Sidebar: precio ──
      if (priceInput) {
        priceInput.addEventListener('input', () => {
          state.maxPrice = parseInt(priceInput.value, 10) || 200;
          if (priceLabel)
            priceLabel.textContent = state.maxPrice >= 200 ? '$200+' : `$${state.maxPrice}`;
          state.page = 1;
          render();
        });
      }

      // ── Sidebar: disponibilidad ──
      (sidebar.querySelectorAll('[data-tienda-avail]') as unknown as HTMLInputElement[]).forEach(
        (cb) => {
          cb.addEventListener('change', () => {
            if (cb.checked) state.avail.add(cb.value);
            else state.avail.delete(cb.value);
            state.page = 1;
            render();
          });
        },
      );

      // ── Sidebar: talla / color (merchandising) ──
      (sidebar.querySelectorAll('.tienda-filter-talla') as unknown as HTMLInputElement[]).forEach(
        (cb) => {
          cb.addEventListener('change', () => {
            if (cb.checked) state.tallas.add(cb.value);
            else state.tallas.delete(cb.value);
            state.page = 1;
            render();
          });
        },
      );
      (sidebar.querySelectorAll('.tienda-filter-color') as unknown as HTMLInputElement[]).forEach(
        (cb) => {
          cb.addEventListener('change', () => {
            if (cb.checked) state.colores.add(cb.value);
            else state.colores.delete(cb.value);
            state.page = 1;
            render();
          });
        },
      );

      // ── Limpiar ──
      const clearBtn = sidebar.querySelector('[data-tienda-clear]');
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          state.chip = '';
          state.avail.clear();
          state.tallas.clear();
          state.colores.clear();
          state.query = '';
          state.maxPrice = 200;
          state.page = 1;
          if (search) search.value = '';
          if (priceInput) priceInput.value = '200';
          if (priceLabel) priceLabel.textContent = '$200+';
          (
            sidebar.querySelectorAll('input[type=checkbox]') as unknown as HTMLInputElement[]
          ).forEach((cb) => (cb.checked = false));
          (chipsWrap.querySelectorAll('[data-filter]') as unknown as HTMLElement[]).forEach((c) => {
            const active = (c.dataset.filter || '') === '';
            c.classList.toggle('tienda-chip--active', active);
            c.setAttribute('aria-pressed', String(active));
          });
          render();
        });
      }

      // ── Ordenar ──
      const sortSel = document.querySelector('[data-tienda-sort]') as HTMLSelectElement | null;
      if (sortSel) {
        sortSel.addEventListener('change', () => {
          state.sort = sortSel.value;
          state.page = 1;
          render();
        });
      }

      render();
    }

    // ── El botón + de la tarjeta lleva a la ficha de detalle (el alta real
    //    requiere elegir variación/talla en la ficha). ──
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement | null;
      const btn = t ? (t.closest('[data-add-to-cart]') as HTMLElement | null) : null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      const card = btn.closest('article');
      const link = card?.querySelector('a[href]') as HTMLAnchorElement | null;
      if (link && link.href) window.location.href = link.href;
    });

    // ── Swatches de color en la card → cambian foto + precio sin navegar y
    //    dejan el color pre-seleccionado en el link al detalle (continuidad). ──
    document.addEventListener('click', (e) => {
      const dot = (e.target as HTMLElement)?.closest('[data-color-dot]') as HTMLElement | null;
      if (!dot) return;
      e.preventDefault();
      e.stopPropagation();
      const card = dot.closest('article');
      const raw = card?.getAttribute('data-variaciones');
      if (!card || !raw) return;
      const variaciones = JSON.parse(raw) as {
        imagen: string | null;
        color: { nombre: string } | null;
        precio: number | null;
      }[];
      const idx = parseInt(dot.dataset.index || '0', 10);
      const v = variaciones[idx];
      const img = card.querySelector('img');
      if (img && v?.imagen) img.src = v.imagen as string;
      // Mover el estado activo (borde + escala + anillo rojo) al dot clicado.
      card.querySelectorAll<HTMLElement>('[data-color-dot]').forEach((d) => {
        const active = d === dot;
        d.classList.toggle('border-egrem-red', active);
        d.classList.toggle('border-white/70', !active);
        d.classList.toggle('scale-110', active);
        d.style.boxShadow = active
          ? '0 0 0 2px white, 0 0 0 3.5px var(--color-egrem-red)'
          : '';
      });
      // Actualizar el precio de la card según la variación previsualizada.
      const priceEl = card.querySelector('[data-product-price]');
      if (priceEl) {
        priceEl.textContent =
          v?.precio != null
            ? '$' + (Math.round((v.precio as number) * 100) / 100).toFixed(2)
            : 'Consultar';
      }
      // Continuidad listado → detalle: el link lleva ?color=.
      const link = card.querySelector('a[href]') as HTMLAnchorElement | null;
      const nombreColor = v?.color?.nombre;
      if (link && nombreColor) {
        const url = new URL(link.getAttribute('href') || '', window.location.origin);
        url.searchParams.set('color', nombreColor);
        link.setAttribute('href', url.pathname + url.search);
      }
    });
  </script>
</BaseLayout>
