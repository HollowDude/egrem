---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSession } from '@/lib/auth/session';
import { getCart, type Cart } from '@/lib/nodehive/carrito';
import { formatPrecio } from '@/lib/moneda';
import { useTranslations } from '@/i18n/translations';

const lang = Astro.locals.lang;
const tr = useTranslations(lang);

const session = await getSession(Astro.cookies);
const authed = !!session;

let cart: Cart = { orderId: null, lines: [], subtotal: 0, count: 0 };
if (authed && session) {
  try {
    cart = await getCart({
      accessToken: session.accessToken,
      csrfToken: session.csrfToken,
      lang,
    });
  } catch (e) {
    console.error('[carrito] getCart failed:', e);
  }
}

const fmt = (v: number) =>
  v !== null ? formatPrecio(v, lang) : tr('tienda.product.consultar');
---

<BaseLayout title={tr('tienda.cart.title')} description={tr('tienda.cart.title')}>
  <main id="main-content" class="container-site py-8 md:py-12">
    <nav class="text-small font-display text-text-secondary mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 flex-wrap m-0 p-0 list-none">
        <li><a href="/" class="hover:text-egrem-red no-underline">Inicio</a></li>
        <li class="text-egrem-gray"><span class="icon" style="font-size:14px">chevron_right</span></li>
        <li><a href="/tienda" class="hover:text-egrem-red no-underline">{tr('nav.store')}</a></li>
        <li class="text-egrem-gray"><span class="icon" style="font-size:14px">chevron_right</span></li>
        <li class="text-egrem-black font-bold" aria-current="page">{tr('tienda.cart.title')}</li>
      </ol>
    </nav>

    <h1 class="text-h1 uppercase mb-8">{tr('tienda.cart.title')}</h1>

    {
      !authed ? (
        <div class="empty-state flex flex-col items-center justify-center py-20 text-center">
          <span class="icon text-6xl text-egrem-gray/40 mb-4">login</span>
          <p class="font-display text-body text-text-secondary mb-6">{tr('tienda.cart.login_required')}</p>
          <a href={`/login?redirect=/carrito`} class="bg-egrem-red text-white font-display font-bold uppercase px-6 py-3 rounded-2xl hover:bg-egrem-red-dark transition-colors no-underline">
            {tr('nav.login')}
          </a>
        </div>
      ) : cart.lines.length === 0 ? (
        <div id="cart-empty" class="empty-state flex flex-col items-center justify-center py-20 text-center">
          <span class="icon text-6xl text-egrem-gray/40 mb-4">shopping_cart</span>
          <p class="font-display text-body text-text-secondary mb-6">{tr('tienda.cart.empty')}</p>
          <a href="/tienda" class="bg-egrem-red text-white font-display font-bold uppercase px-6 py-3 rounded-2xl hover:bg-egrem-red-dark transition-colors no-underline">
            {tr('tienda.cart.empty_cta')}
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
          {/* Lista de líneas */}
          <div class="lg:col-span-2">
            <div id="cart-items">
              {cart.lines.map((line) => (
                <div
                  class="cart-row flex gap-4 py-6 border-b border-egrem-gray-light"
                  data-id={line.orderItemId ?? line.id}
                  data-unit={line.precioUnitario ?? 0}
                >
                  <div class="w-20 h-20 shrink-0 bg-egrem-gray-light border border-form-border rounded-lg overflow-hidden flex items-center justify-center">
                    {line.imagen ? (
                      <img src={line.imagen} alt={line.title} class="w-full h-full object-cover" />
                    ) : (
                      <span class="icon text-3xl text-egrem-gray/40">inventory_2</span>
                    )}
                  </div>

                  <div class="flex-1 min-w-0">
                    <h3 class="font-display font-bold text-[18px] uppercase text-egrem-black leading-tight m-0 truncate">{line.title}</h3>
                    <div class="flex flex-wrap gap-2 mt-1">
                      {line.talla && (
                        <span class="font-display text-[11px] uppercase text-text-secondary border border-form-border rounded px-2 py-0.5">
                          {tr('tienda.product.talla')}: {line.talla}
                        </span>
                      )}
                      {line.color && (
                        <span class="font-display text-[11px] uppercase text-text-secondary border border-form-border rounded px-2 py-0.5">
                          {tr('tienda.product.color')}: {line.color}
                        </span>
                      )}
                      {line.edicion && (
                        <span class="font-display text-[11px] uppercase text-text-secondary border border-form-border rounded px-2 py-0.5">
                          {tr('tienda.product.edicion')}: {line.edicion}
                        </span>
                      )}
                      {line.formato && (
                        <span class="font-display text-[11px] uppercase text-text-secondary border border-form-border rounded px-2 py-0.5">
                          {tr('tienda.product.formato')}: {line.formato}
                        </span>
                      )}
                      {line.sku && (
                        <span class="font-display text-[11px] uppercase text-egrem-gray border border-form-border rounded px-2 py-0.5">
                          {line.sku}
                        </span>
                      )}
                    </div>
                    <p class="font-display text-egrem-red font-bold mt-2 mb-0">{fmt(line.precioUnitario ?? 0)} {tr('tienda.cart.unidad')}</p>
                  </div>

                  <div class="flex flex-col items-end justify-between gap-3">
                    <button
                      type="button"
                      class="cart-remove text-small font-display uppercase text-egrem-gray hover:text-egrem-red transition-colors no-underline"
                      data-remove={line.orderItemId ?? line.id}
                    >
                      {tr('tienda.cart.quitar')}
                    </button>

                    <div class="flex items-center border border-form-border rounded-md overflow-hidden h-10">
                      <button type="button" class="cart-dec w-9 h-full flex items-center justify-center hover:text-egrem-red transition-colors" data-id={line.orderItemId ?? line.id} aria-label="-">
                        <span class="icon" style={{ fontSize: 18 }}>remove</span>
                      </button>
                      <input
                        type="number"
                        min="1"
                        value={line.cantidad}
                        data-qty={line.orderItemId ?? line.id}
                        class="cart-qty w-12 h-full text-center font-display font-bold border-none bg-transparent focus:ring-0 p-0 text-egrem-black"
                        aria-label={tr('tienda.product.cantidad')}
                      />
                      <button type="button" class="cart-inc w-9 h-full flex items-center justify-center hover:text-egrem-red transition-colors" data-id={line.orderItemId ?? line.id} aria-label="+">
                        <span class="icon" style={{ fontSize: 18 }}>add</span>
                      </button>
                    </div>

                    <p class="cart-line-total font-display text-[18px] font-bold text-egrem-black m-0">
                      {fmt((line.precioUnitario ?? 0) * line.cantidad)}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Resumen */}
          <aside class="lg:col-span-1">
            <div class="border border-form-border rounded-2xl p-6 sticky top-24">
              <h2 class="font-display font-bold text-h4 uppercase text-egrem-black mb-4">{tr('tienda.cart.subtotal')}</h2>
              <div class="flex items-center justify-between mb-2">
                <span class="font-display text-body text-text-secondary">{tr('tienda.cart.subtotal')}</span>
                <span id="cart-subtotal" class="font-display text-h3 font-black text-egrem-red">{fmt(cart.subtotal ?? 0)}</span>
              </div>
              <p class="font-display text-small text-egrem-gray mb-6">{tr('tienda.cart.envio_nota')}</p>
              <a
                href="/checkout/merch"
                class="block w-full text-center bg-egrem-red text-white font-display text-[18px] font-bold uppercase py-3 rounded-2xl hover:bg-egrem-red-dark transition-colors no-underline"
              >
                {tr('tienda.cart.proceder_pago')}
              </a>
              <a href="/tienda" class="block text-center mt-4 font-display text-small uppercase text-egrem-gold hover:underline no-underline">
                {tr('tienda.cart.empty_cta')}
              </a>
            </div>
          </aside>
        </div>
      )
    }
  </main>

  <script>
    const fmtLocal = (v: number) => {
      const n = Math.round(v * 100) / 100;
      return '$' + (Number.isInteger(n) ? String(n) : n.toFixed(2));
    };

    async function mutate(method: string, id: string, body?: unknown) {
      const res = await fetch(`/api/cart/items/${id}`, {
        method,
        headers: body ? { 'content-type': 'application/json' } : undefined,
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!res.ok) throw new Error('cart mutation failed');
      return res.json();
    }

    function render(cart: any) {
      const itemsEl = document.getElementById('cart-items');
      const subtotalEl = document.getElementById('cart-subtotal');
      const emptyEl = document.getElementById('cart-empty');
      if (!itemsEl) return;
      if (!cart.lines || cart.lines.length === 0) {
        const wrap = document.getElementById('cart-items')?.parentElement;
        if (wrap && emptyEl) wrap.innerHTML = emptyEl.outerHTML;
        if (subtotalEl) subtotalEl.textContent = fmtLocal(0);
      } else {
        itemsEl.innerHTML = cart.lines
          .map((line: any) => {
            const id = line.orderItemId ?? line.id;
            const unit = line.precioUnitario ?? 0;
            const total = unit * line.cantidad;
            const badges: string[] = [];
            if (line.talla) badges.push(`Talla: ${line.talla}`);
            if (line.color) badges.push(`Color: ${line.color}`);
            if (line.edicion) badges.push(`Edición: ${line.edicion}`);
            if (line.formato) badges.push(`Formato: ${line.formato}`);
            if (line.sku) badges.push(line.sku);
            return `
              <div class="cart-row flex gap-4 py-6 border-b border-egrem-gray-light" data-id="${id}" data-unit="${unit}">
                <div class="w-20 h-20 shrink-0 bg-egrem-gray-light border border-form-border rounded-lg overflow-hidden flex items-center justify-center">
                  ${line.imagen ? `<img src="${line.imagen}" alt="${line.title}" class="w-full h-full object-cover" />` : `<span class="icon text-3xl text-egrem-gray/40">inventory_2</span>`}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-display font-bold text-[18px] uppercase text-egrem-black leading-tight m-0 truncate">${line.title}</h3>
                  <div class="flex flex-wrap gap-2 mt-1">
                    ${badges.map((b) => `<span class="font-display text-[11px] uppercase text-text-secondary border border-form-border rounded px-2 py-0.5">${b}</span>`).join('')}
                  </div>
                  <p class="font-display text-egrem-red font-bold mt-2 mb-0">${fmtLocal(unit)} ud.</p>
                </div>
                <div class="flex flex-col items-end justify-between gap-3">
                  <button type="button" class="cart-remove text-small font-display uppercase text-egrem-gray hover:text-egrem-red transition-colors no-underline" data-remove="${id}">${'Quitar'}</button>
                  <div class="flex items-center border border-form-border rounded-md overflow-hidden h-10">
                    <button type="button" class="cart-dec w-9 h-full flex items-center justify-center hover:text-egrem-red transition-colors" data-id="${id}" aria-label="-"><span class="icon" style="font-size:18px">remove</span></button>
                    <input type="number" min="1" value="${line.cantidad}" data-qty="${id}" class="cart-qty w-12 h-full text-center font-display font-bold border-none bg-transparent focus:ring-0 p-0 text-egrem-black" aria-label="Cantidad" />
                    <button type="button" class="cart-inc w-9 h-full flex items-center justify-center hover:text-egrem-red transition-colors" data-id="${id}" aria-label="+"><span class="icon" style="font-size:18px">add</span></button>
                  </div>
                  <p class="cart-line-total font-display text-[18px] font-bold text-egrem-black m-0">${fmtLocal(total)}</p>
                </div>
              </div>`;
          })
          .join('');
        if (subtotalEl) subtotalEl.textContent = fmtLocal(cart.subtotal ?? 0);
      }
      window.dispatchEvent(new CustomEvent('cart:updated', { detail: { count: cart.count ?? 0 } }));
    }

    document.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const dec = t.closest('.cart-dec') as HTMLElement | null;
      const inc = t.closest('.cart-inc') as HTMLElement | null;
      const rm = t.closest('.cart-remove') as HTMLElement | null;
      const id = (dec ?? inc ?? rm)?.getAttribute('data-id') ?? rm?.getAttribute('data-remove') ?? null;
      if (!id) return;
      try {
        if (rm) {
          const cart = await mutate('DELETE', id);
          render(cart);
        } else if (dec || inc) {
          const input = document.querySelector(`[data-qty="${id}"]`) as HTMLInputElement | null;
          if (!input) return;
          const current = parseInt(input.value, 10) || 1;
          const next = dec ? Math.max(1, current - 1) : current + 1;
          input.value = String(next);
          const cart = await mutate('PATCH', id, { quantity: next });
          render(cart);
        }
      } catch (err) {
        console.error(err);
      }
    });

    document.addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement;
      if (!input.classList.contains('cart-qty')) return;
      const id = input.getAttribute('data-qty');
      if (!id) return;
      const next = Math.max(1, parseInt(input.value, 10) || 1);
      input.value = String(next);
      try {
        const cart = await mutate('PATCH', id, { quantity: next });
        render(cart);
      } catch (err) {
        console.error(err);
      }
    });
  </script>
</BaseLayout>
