---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroCatalogo from '@/components/catalogo/HeroCatalogo.astro';
import VideoDestacado from '@/components/catalogo/VideoDestacado.astro';
import VideoCard from '@/components/catalogo/VideoCard.astro';
import VideoFilterBar from '@/components/catalogo/VideoFilterBar.astro';
import { fetchVideosCatalogo, fetchVideoDestacado, fetchCatalogoHero } from '@/lib/nodehive';
import { useTranslations } from '@/i18n/translations';
import { NODEHIVE_CONFIG } from '@/lib/nodehive/config';

const lang = Astro.locals.lang;
const tr = useTranslations(lang);

const artista = Astro.url.searchParams.get('artista') ?? '';
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1'));

const result = await fetchVideosCatalogo({ artista: artista || undefined, page: currentPage }, lang);
const { videos, total, totalPages, currentPage: page, availableArtistas } = result;
const showingEnd = Math.min(page * 24, total);
const showingStart = total > 0 ? (page - 1) * 24 + 1 : 0;

let hero = null;
try {
  hero = await fetchCatalogoHero('_component_videos_hero', NODEHIVE_CONFIG.pages.videos, lang);
} catch (e) {
  console.error('[catalogo/videos] Failed to fetch hero:', e);
}

let destacado = null;
try {
  destacado = await fetchVideoDestacado(NODEHIVE_CONFIG.pages.videos, lang);
} catch (e) {
  console.error('[catalogo/videos] Failed to fetch destacado:', e);
}

function pageUrl(p: number): string {
  const params = new URLSearchParams();
  if (artista) params.set('artista', artista);
  if (p > 1) params.set('page', String(p));
  const qs = params.toString();
  return `/catalogo/videos${qs ? '?' + qs : ''}`;
}

const paginationStart = Math.max(1, page - 4);
const paginationEnd = Math.min(totalPages, paginationStart + 9);
const visiblePages: number[] = [];
for (let i = paginationStart; i <= paginationEnd; i++) visiblePages.push(i);
---

<BaseLayout
  title={tr('videos.page_title')}
  description={tr('videos.page_description')}
>
  <main id="main-content">
    <HeroCatalogo
      title={hero?.title || tr('videos.hero.title')}
      subtitle={hero?.subtitle || tr('videos.hero.subtitle')}
      photo={hero?.photo}
      nhEntity={hero || undefined}
    />

    {destacado?.youtubeId ? (
      <VideoDestacado video={destacado} />
    ) : null}

    <VideoFilterBar {availableArtistas} {artista} />

    <section class="section-py bg-white">
      <div class="container-site">
        {videos.length === 0 ? (
          <div class="flex flex-col items-center justify-center py-16 text-center">
            <span class="text-5xl text-egrem-gray/40 mb-4" style="font-family: 'Material Symbols Outlined';">videocam_off</span>
            <p class="text-egrem-gray text-body">{tr('videos.no_results')}</p>
          </div>
        ) : (
          <>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">
              {videos.map((video) => (
                <VideoCard video={video} />
              ))}
            </div>

            <div class="mt-12 flex flex-col items-center gap-4">
              <p class="font-display text-[11px] text-egrem-gray uppercase tracking-wider">
                {tr('videos.showing')
                  .replace('{start}', String(showingStart))
                  .replace('{end}', String(showingEnd))
                  .replace('{total}', String(total))}
              </p>
              {totalPages > 1 && (
                <nav class="flex items-center gap-2">
                  {page > 1 && (
                    <a href={pageUrl(page - 1)} class="w-10 h-10 flex items-center justify-center rounded-xl border border-egrem-gray/30 text-egrem-gray hover:bg-egrem-gray-light no-underline" aria-label={tr('videos.pagination.prev')}>
                      <span style="font-family: 'Material Symbols Outlined';">chevron_left</span>
                    </a>
                  )}
                  {visiblePages.map((p) => (
                    <a
                      href={pageUrl(p)}
                      class:list={['w-10 h-10 flex items-center justify-center rounded-xl no-underline font-bold', p === page ? 'bg-egrem-red text-white' : 'border border-egrem-gray/30 text-egrem-black hover:bg-egrem-gray-light']}
                    >{p}</a>
                  ))}
                  {page < totalPages && (
                    <a href={pageUrl(page + 1)} class="w-10 h-10 flex items-center justify-center rounded-xl border border-egrem-gray/30 text-egrem-gray hover:bg-egrem-gray-light no-underline" aria-label={tr('videos.pagination.next')}>
                      <span style="font-family: 'Material Symbols Outlined';">chevron_right</span>
                    </a>
                  )}
                </nav>
              )}
            </div>
          </>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
