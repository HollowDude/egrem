---
import type { NhVideoDestacado } from '@/lib/nodehive';
import { useTranslations } from '@/i18n/translations';

interface Props {
  video: NhVideoDestacado | null;
}

const { video } = Astro.props;
const tr = useTranslations(Astro.locals.lang);

if (!video?.youtubeId) return;
---

<section class="section-py">
  <div class="container-site">
    <a
      href="#"
      data-youtube-id={video.youtubeId}
      class="group relative block w-full aspect-video rounded-2xl overflow-hidden border border-egrem-gray/20 shadow-lg no-underline"
      aria-label={video.title}
    >
      {video.thumbnail ? (
        <img
          src={video.thumbnail}
          alt={video.title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-egrem-dark">
          <span class="text-6xl text-egrem-gray/40" style="font-family: 'Material Symbols Outlined';">videocam</span>
        </div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="w-20 h-20 rounded-full bg-egrem-red/90 flex items-center justify-center group-hover:scale-110 transition-transform">
          <span class="text-white text-5xl" style="font-family: 'Material Symbols Outlined'; font-variation-settings: 'FILL' 1;">play_arrow</span>
        </span>
      </div>
      <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
        <span class="inline-block px-3 py-1 bg-egrem-red text-white text-[11px] uppercase tracking-wider font-display font-bold rounded mb-3">
          {tr('videos.destacado.label')}
        </span>
        <h2 class="text-h2 text-white mb-1">{video.title}</h2>
        {video.detail?.channelTitle && (
          <p class="font-display text-small text-egrem-gold">{video.detail.channelTitle}</p>
        )}
      </div>
    </a>

    <div class="mt-6 max-w-4xl">
      {video.detail?.description && (
        <p class="text-body text-egrem-black/80 whitespace-pre-line leading-relaxed">
          {video.detail.description}
        </p>
      )}
      <div class="flex flex-wrap gap-4 mt-4">
        {video.detail?.viewCount != null && (
          <p class="font-display text-small text-egrem-gray">
            {tr('videos.detail.views').replace('{count}', video.detail.viewCount.toLocaleString(Astro.locals.lang))}
          </p>
        )}
        {video.detail?.publishedAt && (
          <p class="font-display text-small text-egrem-gray">
            {tr('videos.detail.published')}: {new Date(video.detail.publishedAt).toLocaleDateString(Astro.locals.lang, { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        )}
      </div>
    </div>
  </div>
</section>
