---
import { useTranslations } from '@/i18n/translations';

interface Props {
  agencia: { name: string; slug: string; tid: number } | undefined;
}

const { agencia } = Astro.props;
const tr = useTranslations(Astro.locals.lang);
---

{
  agencia && (
    <div class="card card--no-zoom p-6">
      <h3 class="font-display font-bold text-base text-egrem-black mb-4 uppercase tracking-wider border-b border-egrem-gray/20 pb-3">
        {tr('artistas.detail.agencia_label')}
      </h3>
      <p class="font-display text-body text-egrem-black mb-4">{agencia.name}</p>
      <button
        type="button"
        onclick="window.dispatchEvent(new CustomEvent('open-contact-modal',{detail:{variant:'full',inquiry:'Contratación de artista'}}))"
        class="inline-flex items-center gap-2 px-8 py-3 bg-egrem-red text-white font-display font-bold text-[11px] uppercase tracking-wider rounded-full hover:bg-egrem-red-dark hover:scale-105 active:scale-[0.97] transition-all duration-200 cursor-pointer border-none"
      >
        {tr('artistas.detail.booking')}
      </button>
    </div>
  )
}
