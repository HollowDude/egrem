---
/**
 * TiendaFilterBar.astro — Filtros SSR de la tienda (Entradas).
 * Tipo, sede, rango de precio, disponibilidad, orden y búsqueda.
 */
import { useTranslations } from '@/i18n/translations';
import type { TiendaFilters, TiendaSort } from '@/lib/tienda/filters';

interface Opcion {
  slug: string;
  label: string;
}

interface Props {
  tipos: Opcion[];
  sedes: Opcion[];
  filtros: TiendaFilters;
  orden: TiendaSort;
  basePath: string;
}

const tr = useTranslations(Astro.locals.lang);
const { tipos, sedes, filtros, orden, basePath } = Astro.props;

const ordenes: { value: TiendaSort; label: string }[] = [
  { value: 'proximos', label: tr('tienda.filter.orden.proximos') },
  { value: 'precio-asc', label: tr('tienda.filter.orden.precio-asc') },
  { value: 'precio-desc', label: tr('tienda.filter.orden.precio-desc') },
];

const hayFiltros =
  filtros.tipo || filtros.sede || filtros.precioMin || filtros.precioMax || filtros.disponibilidad || filtros.q;
---

<section class="bg-egrem-gray-light border-b border-egrem-gray/20">
  <div class="container-site py-5">
    <form method="GET" action={basePath} class="flex flex-wrap items-end gap-3">
      <div class="flex flex-col gap-1">
        <label class="font-display font-bold text-[10px] text-egrem-gold uppercase tracking-widest" for="t-tipo">
          {tr('tienda.filter.tipo')}
        </label>
        <select
          id="t-tipo"
          name="tipo"
          class="bg-white border border-egrem-gray/30 text-egrem-black rounded-full focus:border-egrem-gold focus:ring-0 font-display text-small py-1.5 px-4 min-w-[160px]"
          onchange="this.form.submit()"
        >
          <option value="">{tr('tienda.filter.tipo.all')}</option>
          {tipos.map((t) => (
            <option value={t.slug} selected={filtros.tipo === t.slug}>{t.label}</option>
          ))}
        </select>
      </div>

      <div class="flex flex-col gap-1">
        <label class="font-display font-bold text-[10px] text-egrem-gold uppercase tracking-widest" for="t-sede">
          {tr('tienda.filter.sede')}
        </label>
        <select
          id="t-sede"
          name="sede"
          class="bg-white border border-egrem-gray/30 text-egrem-black rounded-full focus:border-egrem-gold focus:ring-0 font-display text-small py-1.5 px-4 min-w-[160px]"
          onchange="this.form.submit()"
        >
          <option value="">{tr('tienda.filter.sede.all')}</option>
          {sedes.map((s) => (
            <option value={s.slug} selected={filtros.sede === s.slug}>{s.label}</option>
          ))}
        </select>
      </div>

      <div class="flex flex-col gap-1">
        <span class="font-display font-bold text-[10px] text-egrem-gold uppercase tracking-widest">
          {tr('tienda.filter.precio')}
        </span>
        <div class="flex items-center gap-2">
          <input
            type="number"
            name="precioMin"
            value={filtros.precioMin ?? ''}
            min="0"
            placeholder={tr('tienda.filter.precio.min')}
            aria-label={tr('tienda.filter.precio.min')}
            class="bg-white border border-egrem-gray/30 text-egrem-black rounded-full focus:border-egrem-gold focus:ring-0 font-display text-small py-1.5 px-4 w-[110px]"
            onchange="this.form.submit()"
          />
          <span class="text-egrem-gray font-display text-small">–</span>
          <input
            type="number"
            name="precioMax"
            value={filtros.precioMax ?? ''}
            min="0"
            placeholder={tr('tienda.filter.precio.max')}
            aria-label={tr('tienda.filter.precio.max')}
            class="bg-white border border-egrem-gray/30 text-egrem-black rounded-full focus:border-egrem-gold focus:ring-0 font-display text-small py-1.5 px-4 w-[110px]"
            onchange="this.form.submit()"
          />
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <label class="font-display font-bold text-[10px] text-egrem-gold uppercase tracking-widest" for="t-disp">
          {tr('tienda.filter.disponibilidad')}
        </label>
        <select
          id="t-disp"
          name="disponibilidad"
          class="bg-white border border-egrem-gray/30 text-egrem-black rounded-full focus:border-egrem-gold focus:ring-0 font-display text-small py-1.5 px-4 min-w-[150px]"
          onchange="this.form.submit()"
        >
          <option value="">{tr('tienda.filter.disponibilidad.all')}</option>
          <option value="disponibles" selected={filtros.disponibilidad === 'disponibles'}>
            {tr('tienda.filter.disponibilidad.disponibles')}
          </option>
          <option value="agotados" selected={filtros.disponibilidad === 'agotados'}>
            {tr('tienda.filter.disponibilidad.agotados')}
          </option>
        </select>
      </div>

      <div class="flex flex-col gap-1">
        <label class="font-display font-bold text-[10px] text-egrem-gold uppercase tracking-widest" for="t-orden">
          {tr('tienda.filter.orden')}
        </label>
        <select
          id="t-orden"
          name="orden"
          class="bg-white border border-egrem-gray/30 text-egrem-black rounded-full focus:border-egrem-gold focus:ring-0 font-display text-small py-1.5 px-4 min-w-[170px]"
          onchange="this.form.submit()"
        >
          {ordenes.map((o) => (
            <option value={o.value} selected={orden === o.value}>{o.label}</option>
          ))}
        </select>
      </div>

      <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
        <label class="font-display font-bold text-[10px] text-egrem-gold uppercase tracking-widest" for="t-q">
          {tr('tienda.filter.search')}
        </label>
        <input
          id="t-q"
          type="text"
          name="q"
          value={filtros.q}
          placeholder={tr('tienda.filter.search_placeholder')}
          class="bg-white border border-egrem-gray/30 text-egrem-black rounded-full focus:border-egrem-gold focus:ring-0 font-display text-small py-1.5 px-4 w-full"
        />
      </div>

      <button
        type="submit"
        class="inline-flex px-5 py-1.5 bg-egrem-red text-white font-display font-bold text-[11px] uppercase tracking-wider rounded-full hover:bg-egrem-red-dark transition-colors"
      >
        {tr('tienda.filter.submit')}
      </button>
      {hayFiltros && (
        <a
          href={basePath}
          class="text-[11px] font-display font-bold text-egrem-gray uppercase tracking-wider hover:text-egrem-red transition-colors no-underline"
        >
          {tr('tienda.filter.clear')}
        </a>
      )}
    </form>
  </div>
</section>
