<script>
  import { subscribeCartQty, getCartQty, getCartQtyForStore } from '@/lib/tienda/cartStore';

  type StockTienda = {
    ilimitado?: boolean;
    cantidad?: number;
    tienda: { id: string; label?: string; provincia?: string; municipio?: string };
  };
  type Var = {
    uuid: string;
    variationId: number | null;
    talla: string | null;
    color: { nombre: string; hex: string } | null;
    edicion: string | null;
    formato: string | null;
    disponible: boolean;
    stock: number | null;
    precio: number | null;
    sku?: string | null;
    stockPorTienda?: StockTienda[];
    imagen?: string | null;
    imagenVarianteUrl?: string | null;
    materiales?: string | null;
    garantia?: string | null;
    accesoriosIncluidos?: string | null;
  };
  type Sel = { talla?: string; color?: string; edicion?: string; formato?: string };

  // Tiendas permitidas por el filtro de zona (vacío = sin filtro geográfico).
  let tiendasPermitidas: Set<string> = new Set();
  function leerPermitidasInicial(): void {
    const grid = document.querySelector('[data-tiendas-permitidas]');
    try {
      const arr = JSON.parse(grid?.getAttribute('data-tiendas-permitidas') || '[]');
      if (Array.isArray(arr)) tiendasPermitidas = new Set(arr as string[]);
    } catch {
      tiendasPermitidas = new Set();
    }
  }
  leerPermitidasInicial();
  window.addEventListener('ubicacion:cambiada', (e: Event) => {
    const detail = (e as CustomEvent).detail as { tiendasPermitidas?: string[] };
    tiendasPermitidas = new Set(detail.tiendasPermitidas ?? []);
    document.querySelectorAll('article[data-tiendas]').forEach((c) => evaluarZona(c as HTMLElement));
  });

  function hayDisponible(catalogo: Var[], sel: Sel): boolean {
    return catalogo.some(
      (v) =>
        v.disponible &&
        (!sel.talla || v.talla === sel.talla) &&
        (!sel.color || (v.color && v.color.nombre === sel.color)) &&
        (!sel.edicion || v.edicion === sel.edicion) &&
        (!sel.formato || v.formato === sel.formato),
    );
  }

  function resolver(catalogo: Var[], sel: Sel): Var | null {
    const cands = catalogo.filter(
      (v) =>
        (!sel.talla || v.talla === sel.talla) &&
        (!sel.color || (v.color && v.color.nombre === sel.color)) &&
        (!sel.edicion || v.edicion === sel.edicion) &&
        (!sel.formato || v.formato === sel.formato),
    );
    return cands.find((v) => v.disponible) ?? null;
  }

  function seleccionCompleta(dims: string[], sel: Sel): boolean {
    return dims.every((d) => !!sel[d as keyof Sel]);
  }

  function leerCatalogo(card: Element | null): Var[] {
    try {
      return JSON.parse(card?.getAttribute('data-catalogo') || '[]') as Var[];
    } catch {
      return [];
    }
  }

  // Solo el icono del botón (nunca texto): el feedback textual va al estado visible.
  function iconoBoton(btn: HTMLElement, name: string): void {
    btn.innerHTML =
      '<span class="icon' + (name === 'autorenew' ? ' is-spin' : '') + '">' + name + '</span>';
  }

  // Mensaje de alta rápida fuera del botón (visible, accesible vía role=status).
  function mostrarEstado(
    card: Element | null,
    tipo: 'added' | 'error' | 'oos',
    msg: string,
  ): void {
    const el = card?.querySelector('[data-quickbuy-status]') as HTMLElement | null;
    if (!el) return;
    el.textContent = '';
    el.className = 'quickbuy-status quickbuy-status--' + tipo;
    const ic = document.createElement('span');
    ic.className = 'icon';
    ic.setAttribute('aria-hidden', 'true');
    ic.style.fontSize = '16px';
    ic.textContent = tipo === 'added' ? 'check_circle' : tipo === 'oos' ? 'block' : 'error';
    el.appendChild(ic);
    el.appendChild(document.createTextNode(' ' + msg));
    el.classList.add('is-visible');
    window.clearTimeout((el as unknown as { _toc?: number })._toc);
    (el as unknown as { _toc?: number })._toc = window.setTimeout(() => {
      el.classList.remove('is-visible');
      el.textContent = '';
    }, 2600);
  }

  /** Stock disponible para una variación. `soloZona`=true solo cuenta tiendas de la zona filtrada. */
  function stockDisponible(v: Var, soloZona: boolean): boolean {
    const sp = v.stockPorTienda ?? [];
    for (const s of sp) {
      const sid = s.tienda?.id;
      if (!sid) continue;
      if (soloZona && tiendasPermitidas.size > 0 && !tiendasPermitidas.has(sid)) continue;
      const base = s.ilimitado ? Number.MAX_SAFE_INTEGER : (s.cantidad ?? 0);
      const enCarrito = getCartQtyForStore(v.sku, sid);
      if (base - enCarrito > 0) return true;
    }
    return false;
  }

  /** Modal de confirmación cuando no hay stock en la zona y se usará una tienda fuera de ella. */
  function confirmarFueraDeZona(
    tienda: { label?: string; provincia?: string; municipio?: string },
  ): Promise<boolean> {
    return new Promise((resolve) => {
      const nombre = tienda.label ?? 'otra tienda';
      const lugar = [tienda.municipio, tienda.provincia].filter(Boolean).join(', ');
      const overlay = document.createElement('div');
      overlay.className = 'zona-confirm';
      overlay.innerHTML =
        '<div class="zona-confirm__modal" role="alertdialog" aria-modal="true" aria-labelledby="zc-title" aria-describedby="zc-msg">' +
        '<div class="zona-confirm__icon" aria-hidden="true"><span class="icon">warning</span></div>' +
        '<h2 class="zona-confirm__title" id="zc-title">Sin stock en tu zona</h2>' +
        '<p class="zona-confirm__msg" id="zc-msg">No hay disponibilidad en las tiendas de tu zona. ¿Añadir desde <strong>' +
        nombre +
        '</strong>' +
        (lugar ? ' (' + lugar + ')' : '') +
        '?</p>' +
        '<div class="zona-confirm__actions">' +
        '<button type="button" class="zona-confirm__no" data-no>Cancelar</button>' +
        '<button type="button" class="zona-confirm__yes" data-yes>Añadir</button>' +
        '</div></div>';
      document.body.appendChild(overlay);
      const yesBtn = overlay.querySelector('[data-yes]') as HTMLButtonElement | null;
      const cerrar = (val: boolean) => {
        document.removeEventListener('keydown', onKey);
        overlay.remove();
        resolve(val);
      };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          cerrar(false);
        }
      };
      overlay.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-yes]')) cerrar(true);
        else if (t.closest('[data-no]') || t === overlay) cerrar(false);
      });
      document.addEventListener('keydown', onKey);
      yesBtn?.focus();
    });
  }

  /** Deshabilita el botón solo cuando la variación no tiene stock en ningún lado. */
  function evaluarZona(card: HTMLElement | null): void {
    if (!card) return;
    // Sin filtro de zona → siempre habilitado (la elección fuera de zona pide confirmación).
    if (tiendasPermitidas.size === 0) {
      card.querySelectorAll('[data-quickbuy-add],[data-quickbuy-toggle]').forEach((b) => ((b as HTMLButtonElement).disabled = false));
      card.classList.remove('zona-agotado');
      return;
    }
    const catalogo = leerCatalogo(card);
    const sel = leerSeleccionCard(card);
    const v = resolver(catalogo, sel) ?? catalogo.find((x) => x.disponible) ?? null;
    const ok = v ? stockDisponible(v, false) : false; // hay stock en algún lado
    const addBtn = card.querySelector('[data-quickbuy-add]') as HTMLButtonElement | null;
    if (addBtn) addBtn.disabled = !ok;
    if (card.getAttribute('data-directo') === '1') {
      const toggle = card.querySelector('[data-quickbuy-toggle]') as HTMLButtonElement | null;
      if (toggle) toggle.disabled = !ok;
    }
    card.classList.toggle('zona-agotado', !ok);
  }

  async function agregar(btn: HTMLElement, v: Var, tipo: string, titulo: string) {
    if (btn.getAttribute('data-loading') === '1') return;
    btn.setAttribute('data-loading', '1');
    const original = btn.innerHTML;
    iconoBoton(btn, 'autorenew');
    const card = btn.closest('article');
    // Elegir la tienda: preferencia en la zona filtrada; si no hay en zona pero sí
    // fuera, pedir confirmación antes de añadir de una tienda ajena a la zona.
    const sp = v.stockPorTienda ?? [];
    const disponibleEn = (s: StockTienda): boolean => {
      const base = s.ilimitado ? Number.MAX_SAFE_INTEGER : (s.cantidad ?? 0);
      return base - getCartQtyForStore(v.sku, s.tienda.id) > 0;
    };
    let storeId: string | null = null;
    let tiendaFuera: StockTienda | null = null;
    // 1) tienda dentro de la zona con stock
    for (const s of sp) {
      const sid = s.tienda?.id;
      if (!sid) continue;
      if (tiendasPermitidas.size > 0 && !tiendasPermitidas.has(sid)) continue;
      if (disponibleEn(s)) {
        storeId = sid;
        break;
      }
    }
    // 2) sin stock en zona → una fuera de zona requiere confirmación
    if (!storeId && tiendasPermitidas.size > 0) {
      for (const s of sp) {
        const sid = s.tienda?.id;
        if (!sid || tiendasPermitidas.has(sid)) continue;
        if (disponibleEn(s)) {
          tiendaFuera = s;
          break;
        }
      }
      if (tiendaFuera) {
        const acepta = await confirmarFueraDeZona(tiendaFuera.tienda);
        if (!acepta) {
          btn.removeAttribute('data-loading');
          btn.innerHTML = original;
          return;
        }
        storeId = tiendaFuera.tienda.id;
      }
    }
    if (!storeId) {
      // Sin stock en ningún lado → no añadir (el mensaje se muestra fuera del botón).
      btn.removeAttribute('data-loading');
      btn.innerHTML = original;
      mostrarEstado(card, 'oos', btn.getAttribute('data-oos-label') || 'Agotado');
      return;
    }
    const payload = {
      variationUuid: v.uuid,
      variationId: v.variationId,
      bundle: tipo,
      quantity: 1,
      talla: v.talla ?? null,
      color: v.color?.nombre ?? null,
      edicion: v.edicion ?? null,
      formato: v.formato ?? null,
      sku: v.sku ?? null,
      title: titulo,
      precioUnitario: v.precio ?? null,
      imagen: null,
      storeId,
    };
    try {
      const res = await fetch('/api/cart/add', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.status === 401) {
        window.location.href = '/login?redirect=' + encodeURIComponent(window.location.pathname);
        return;
      }
      if (!res.ok) {
        let esStock = false;
        try {
          const b = (await res.json().catch(() => null)) as { message?: string } | null;
          esStock = b?.message === 'stock_insufficient';
        } catch {}
        btn.removeAttribute('data-loading');
        btn.innerHTML = original;
        mostrarEstado(
          card,
          esStock ? 'oos' : 'error',
          esStock
            ? btn.getAttribute('data-oos-label') || 'Agotado'
            : btn.getAttribute('data-error-label') || 'Error',
        );
        return;
      }
      const data = (await res.json().catch(() => null)) as { count?: number } | null;
      const count = typeof data?.count === 'number' ? data.count : undefined;
      window.dispatchEvent(
        new CustomEvent('cart:updated', {
          detail: { variationId: v.variationId, quantity: 1, count },
        }),
      );
      const variacionLabel = [v.talla, v.color?.nombre, v.edicion, v.formato]
        .filter(Boolean)
        .join(' · ');
      window.dispatchEvent(
        new CustomEvent('cart:added', {
          detail: { title: titulo, variation: variacionLabel || null, quantity: 1, count },
        }),
      );
      const addedLabel = btn.getAttribute('data-added-label') || 'Añadido';
      iconoBoton(btn, 'check');
      mostrarEstado(card, 'added', addedLabel);
      window.setTimeout(() => {
        btn.innerHTML = original;
        btn.removeAttribute('data-loading');
      }, 1600);
    } catch {
      btn.removeAttribute('data-loading');
      btn.innerHTML = original;
      mostrarEstado(card, 'error', btn.getAttribute('data-error-label') || 'Error');
    }
  }

  function cerrarPopover(pop: HTMLElement) {
    pop.setAttribute('hidden', '');
    pop.classList.remove('is-open');
    const tg = pop.closest('article')?.querySelector('[data-quickbuy-toggle]') as HTMLElement | null;
    tg?.setAttribute('aria-expanded', 'false');
  }

  function actualizar(pop: HTMLElement) {
    const card = pop.closest('article');
    const catalogo = leerCatalogo(card);
    const dims = (card?.getAttribute('data-dims') || '').split(',').filter(Boolean);
    const sel: Sel = {};
    pop.querySelectorAll('[data-dim][aria-pressed="true"]').forEach((c) => {
      const el = c as HTMLElement;
      (sel as Record<string, string>)[el.getAttribute('data-dim') || ''] = el.getAttribute('data-val') || '';
    });
    pop.querySelectorAll('[data-dim-row]').forEach((row) => {
      const r = row as HTMLElement;
      const dim = r.getAttribute('data-dim-row') || '';
      const parcial: Sel = { ...sel };
      delete (parcial as Record<string, string>)[dim];
      r.querySelectorAll('[data-dim]').forEach((c) => {
        const el = c as HTMLElement;
        const val = el.getAttribute('data-val') || '';
        const disp = hayDisponible(catalogo, { ...parcial, [dim]: val } as Sel);
        if (!disp) el.setAttribute('disabled', '');
        else el.removeAttribute('disabled');
      });
    });
    const completa = seleccionCompleta(dims, sel);
    const v = completa ? resolver(catalogo, sel) : null;
    const add = pop.querySelector('[data-quickbuy-add]') as HTMLButtonElement | null;
    const priceEl = pop.querySelector('[data-quickbuy-price]');
    if (v && v.precio != null && priceEl) {
      priceEl.textContent = '$' + (Math.round(v.precio * 100) / 100).toFixed(2);
    }
    if (add) {
      const sinStock = v ? getCartQty(v.sku) >= (v.stock ?? Infinity) : false;
      // Habilitado si hay stock en algún lado (el alta pide confirmación si es fuera de zona).
      if (completa && v && !sinStock && stockDisponible(v, false)) add.removeAttribute('disabled');
      else add.setAttribute('disabled', '');
    }
  }

  function leerSeleccionCard(card: Element | null): Sel {
    const sel: Sel = {};
    const c = card?.getAttribute('data-selected-color');
    if (c) sel.color = c;
    const ed = card?.getAttribute('data-selected-edicion');
    if (ed) sel.edicion = ed;
    const fm = card?.getAttribute('data-selected-formato');
    if (fm) sel.formato = fm;
    // Instrumento: no tiene dimensión en Sel, pero guardamos uuid para directo
    return sel;
  }

  function sincronizarPopover(pop: HTMLElement, card: Element | null) {
    const sel = leerSeleccionCard(card);
    pop.querySelectorAll('[data-dim]').forEach((el) => {
      const e = el as HTMLElement;
      if (sel[e.getAttribute('data-dim') as keyof Sel] === e.getAttribute('data-val')) {
        e.setAttribute('aria-pressed', 'true');
      }
    });
    actualizar(pop);
  }

  // Deshabilita el botón "agregar" de cada tarjeta cuando el carrito ya
  // contiene todo el stock disponible de esa variación (o está agotada).
  function refrescarEstadoStock() {
    document.querySelectorAll('[data-quickbuy-direct]').forEach((el) => {
      const btn = el as HTMLButtonElement;
      const card = btn.closest('article');
      const catalogo = leerCatalogo(card);
      const uuid = btn.getAttribute('data-variacion') || '';
      const sku = btn.getAttribute('data-sku') || '';
      const v = catalogo.find((x) => x.uuid === uuid);
      const stock = v?.stock ?? null;
      const sinStock = stock != null && getCartQty(sku) >= stock;
      if (sinStock) {
        btn.setAttribute('disabled', '');
        btn.classList.add('is-oos');
        const label = btn.getAttribute('data-oos-label');
        if (label) btn.setAttribute('title', label);
      } else {
        btn.removeAttribute('disabled');
        btn.classList.remove('is-oos');
      }
    });
    document.querySelectorAll('[data-quickbuy]:not([hidden])').forEach((p) => actualizar(p as HTMLElement));
  }

  subscribeCartQty(refrescarEstadoStock);
  refrescarEstadoStock();

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;

    // Cerrar al hacer click fuera de cualquier popover abierto.
    const popAbierto = t.closest('[data-quickbuy]:not([hidden])');
    if (!popAbierto) {
      document.querySelectorAll('[data-quickbuy]:not([hidden])').forEach((p) => cerrarPopover(p as HTMLElement));
    }

    const dentro = t.closest('[data-quickbuy]');

    // Seleccionar color desde los swatches de la card (cambia la foto y memoriza la variante).
    const dot = t.closest('[data-color-dot]') as HTMLElement | null;
    if (dot) {
      e.preventDefault();
      if (dot.hasAttribute('disabled')) return;
      const card = dot.closest('article');
      const color = dot.getAttribute('data-color') ?? dot.getAttribute('aria-label') ?? '';
      card?.querySelectorAll('[data-color-dot]').forEach((d) => d.classList.remove('is-active'));
      dot.classList.add('is-active');
      if (color) card?.setAttribute('data-selected-color', color);
      const img = card?.querySelector('img');
      const imgUrl = dot.getAttribute('data-img');
      if (img && imgUrl) img.setAttribute('src', imgUrl);
      return;
    }

    // Preview switcher: disco formato / libro edicion / instrumento enumeración (actualiza precio/imagen/meta sin abrir popover)
    const variantChip = t.closest('[data-variant-chip]') as HTMLElement | null;
    if (variantChip && !variantChip.closest('[data-quickbuy]')) {
      e.preventDefault();
      if (variantChip.hasAttribute('disabled')) return;
      const card = variantChip.closest('article');
      const tipo = variantChip.getAttribute('data-variant-type') || '';
      const group = variantChip.closest('[data-variant-switcher]');
      if (group) {
        group.querySelectorAll('[data-variant-chip]').forEach((el) => {
          el.setAttribute('aria-pressed', 'false');
          el.classList.remove('bg-egrem-black', 'text-white', 'border-egrem-black', 'shadow-sm', 'shadow-md');
          if (tipo === 'instrumento') {
            el.classList.add('bg-white', 'text-egrem-black', 'border-form-border');
            const ip = el.querySelector('span:last-child') as HTMLElement | null;
            if (ip) {
              ip.classList.remove('text-white/70', 'text-white');
              ip.classList.add('text-text-secondary');
            }
            const lb = el.querySelector('span:first-child') as HTMLElement | null;
            if (lb) {
              lb.classList.remove('text-white');
              lb.classList.add('text-egrem-black');
            }
          } else {
            el.classList.add('bg-white', 'text-text-secondary', 'border-form-border');
          }
        });
        variantChip.setAttribute('aria-pressed', 'true');
        variantChip.classList.remove('bg-white', 'text-text-secondary', 'text-egrem-black', 'border-form-border');
        variantChip.classList.add('bg-egrem-black', 'text-white', 'border-egrem-black');
        variantChip.classList.add(tipo === 'instrumento' ? 'shadow-md' : 'shadow-sm');
        if (tipo === 'instrumento') {
          const ip = variantChip.querySelector('span:last-child') as HTMLElement | null;
          if (ip) {
            ip.classList.remove('text-text-secondary');
            ip.classList.add('text-white/70');
          }
          const lb = variantChip.querySelector('span:first-child') as HTMLElement | null;
          if (lb) {
            lb.classList.remove('text-egrem-black');
            lb.classList.add('text-white');
          }
        }
      }
      const catalogo = leerCatalogo(card);
      let v: Var | null = null;
      if (tipo === 'edicion') {
        const val = variantChip.getAttribute('data-variant-val') || '';
        v = catalogo.find((x) => x.edicion === val) ?? null;
      } else if (tipo === 'formato') {
        const val = variantChip.getAttribute('data-variant-val') || '';
        v = catalogo.find((x) => x.formato === val) ?? null;
      } else if (tipo === 'instrumento') {
        const idx = parseInt(variantChip.getAttribute('data-variant-idx') || '0', 10);
        v = catalogo[idx] ?? null;
        const meta = card?.querySelector('[data-instrumento-meta] .instrumento-meta-text') as HTMLElement | null;
        if (meta && v) {
          const mat = v.materiales ? `<span class="font-bold">Material:</span> ${v.materiales}` : '';
          const gar = v.garantia ? ` <span class="text-text-secondary">·</span> <span class="font-bold">Garantía:</span> ${v.garantia}` : '';
          const acc = !mat && !gar && v.accesoriosIncluidos ? `<span class="font-bold">Incluye:</span> ${v.accesoriosIncluidos}` : '';
          meta.innerHTML = mat || gar ? mat + gar : acc || '<span class="text-text-secondary">Selecciona una variante</span>';
        }
      }
      if (v) {
        const priceEl = card?.querySelector('[data-product-price]') as HTMLElement | null;
        if (priceEl && v.precio != null) priceEl.textContent = `$${v.precio.toFixed(2)}`;
        const img = card?.querySelector('img') as HTMLImageElement | null;
        const imgUrl =
          variantChip.getAttribute('data-img') ||
          (v as unknown as { imagenVarianteUrl?: string }).imagenVarianteUrl ||
          (v as unknown as { imagen?: string }).imagen ||
          '';
        if (img && imgUrl) img.setAttribute('src', imgUrl);
        const directBtn = card?.querySelector('[data-quickbuy-direct]') as HTMLElement | null;
        if (directBtn && v.uuid) {
          directBtn.setAttribute('data-variacion', v.uuid);
          directBtn.setAttribute('data-sku', v.sku || '');
        }
        if (tipo === 'instrumento' && v.uuid) card?.setAttribute('data-selected-instrumento', v.uuid);
        if (tipo === 'edicion' && v.edicion) card?.setAttribute('data-selected-edicion', v.edicion);
        if (tipo === 'formato' && v.formato) card?.setAttribute('data-selected-formato', v.formato);
      }
      return;
    }

    const toggle = t.closest('[data-quickbuy-toggle]') as HTMLElement | null;
    if (toggle) {
      e.preventDefault();
      e.stopPropagation();
      const card = toggle.closest('article');
      const pop = card?.querySelector('[data-quickbuy]') as HTMLElement | null;
      if (!pop) return;
      // Si ya se eligió el color en la card y eso completa la selección, añadir directo.
      const dims = (card?.getAttribute('data-dims') || '').split(',').filter(Boolean);
      const sel = leerSeleccionCard(card);
      if (seleccionCompleta(dims, sel)) {
        const catalogo = leerCatalogo(card);
        const v = resolver(catalogo, sel);
        if (v) {
          agregar(
            toggle,
            v,
            card?.getAttribute('data-tipo') || '',
            card?.getAttribute('data-titulo') || '',
          );
          return;
        }
      }
      if (pop.hasAttribute('hidden')) {
        pop.removeAttribute('hidden');
        pop.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        sincronizarPopover(pop, card);
        (pop.querySelector('button:not([disabled])') as HTMLElement | null)?.focus();
      } else {
        cerrarPopover(pop);
      }
      return;
    }

    const close = t.closest('[data-quickbuy-close]') as HTMLElement | null;
    if (close) {
      e.preventDefault();
      e.stopPropagation();
      const pop = close.closest('[data-quickbuy]') as HTMLElement;
      cerrarPopover(pop);
      return;
    }

    const chip = t.closest('[data-dim]') as HTMLElement | null;
    if (chip && dentro) {
      e.preventDefault();
      e.stopPropagation();
      const activo = chip.getAttribute('aria-pressed') === 'true';
      chip.parentElement
        ?.querySelectorAll('[data-dim]')
        .forEach((c) => (c as HTMLElement).setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', activo ? 'false' : 'true');
      actualizar(chip.closest('[data-quickbuy]') as HTMLElement);
      return;
    }

    const add = t.closest('[data-quickbuy-add]') as HTMLElement | null;
    if (add && dentro) {
      e.preventDefault();
      e.stopPropagation();
      const pop = add.closest('[data-quickbuy]') as HTMLElement;
      const card = pop.closest('article');
      const catalogo = leerCatalogo(card);
      const dims = (card?.getAttribute('data-dims') || '').split(',').filter(Boolean);
      const sel: Sel = {};
      pop.querySelectorAll('[data-dim][aria-pressed="true"]').forEach((c) => {
        const el = c as HTMLElement;
        (sel as Record<string, string>)[el.getAttribute('data-dim') || ''] = el.getAttribute('data-val') || '';
      });
      const v = resolver(catalogo, sel);
      if (!v || !seleccionCompleta(dims, sel)) return;
      agregar(add, v, add.getAttribute('data-bundle') || '', add.getAttribute('data-titulo') || '');
      cerrarPopover(pop);
      return;
    }

    const direct = t.closest('[data-quickbuy-direct]') as HTMLElement | null;
    if (direct) {
      e.preventDefault();
      e.stopPropagation();
      const card = direct.closest('article');
      const catalogo = leerCatalogo(card);
      const uuid = direct.getAttribute('data-variacion') || '';
      const v = catalogo.find((x) => x.uuid === uuid) || null;
      if (v) agregar(direct, v, direct.getAttribute('data-bundle') || '', direct.getAttribute('data-titulo') || '');
      return;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-quickbuy]:not([hidden])').forEach((p) => cerrarPopover(p as HTMLElement));
    }
  });

  // Deshabilitar el alta rápida cuando la variación no tiene stock en la zona filtrada,
  // y reaccionar a cambios de carrito (lo ya agregado descuenta el stock disponible).
  document.querySelectorAll('article[data-tiendas]').forEach((c) => evaluarZona(c as HTMLElement));
  subscribeCartQty(() => {
    document.querySelectorAll('article[data-tiendas]').forEach((c) => evaluarZona(c as HTMLElement));
  });
</script>
