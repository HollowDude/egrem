---
/**
 * TiendaProductCard.astro — Tarjeta de producto genérica (maqueta Tienda/code.html 741-758).
 * Badge esquina superior-izquierda, imagen cuadrada con padding, precio dorado,
 * botón de compra rápida (bg-egrem-red). Card clicable vía stretched-link al detalle.
 *
 * Compra rápida: si el producto tiene varias variaciones que requieren elección
 * (talla/color/edición/formato), el botón + abre un panel inline minimalista
 * (no modal) para elegir la combinación y añadir al carrito sin salir del listado.
 * Si no requiere selección (p. ej. instrumento) añade directo.
 */
import type { TiendaProducto } from '@/types/tienda';
import type { TipoArticulo } from '@/types/producto';
import { useTranslations } from '@/i18n/translations';
import {
  dimensionesRequeridas,
  tallasDisponibles,
  coloresDisponibles,
  edicionesDisponibles,
  formatosDisponibles,
} from '@/lib/tienda/productoSeleccion';

interface Props {
  producto: TiendaProducto;
  lang?: 'es' | 'en';
  ctaLabel?: string;
  mostrarCta?: boolean;
}

const { producto, lang = 'es', ctaLabel, mostrarCta = true } = Astro.props;
const tr = useTranslations(lang);

const esNovedad = producto.badge === 'Novedad' || producto.badge === 'Oferta';
const detailHref = producto.href ?? '';

const esCompra = !!producto.catalogo && producto.catalogo.length > 0;
const requeridas = esCompra ? dimensionesRequeridas(producto.tipo as TipoArticulo) : [];
const catalogo = producto.catalogo ?? [];
const hayDisp = catalogo.some((v) => v.disponible);
const primeraDisp = catalogo.find((v) => v.disponible) ?? null;
const directo = esCompra && hayDisp && (catalogo.length === 1 || requeridas.length === 0) && !!primeraDisp;
const necesitaPopover = esCompra && hayDisp && !directo;
const agotado = esCompra && !hayDisp;

// Instrumento: enumerar hasta 4 variaciones para preview rápida (material/garantía)
const instrumentoVars =
  producto.tipo === 'instrumento' && catalogo.length > 1 ? catalogo.slice(0, 4) : [];
const instrumentoDefault = instrumentoVars.find((v) => v.disponible) ?? instrumentoVars[0] ?? null;

const ediciones = [...new Set(catalogo.map((v) => v.edicion).filter((x): x is string => !!x))];
const formatos = [...new Set(catalogo.map((v) => v.formato).filter((x): x is string => !!x))];

const _precioBase =
  producto.tipo === 'instrumento' && instrumentoDefault?.precio != null
    ? instrumentoDefault.precio
    : (producto.tipo === 'libro' || producto.tipo === 'disco') && primeraDisp?.precio != null
      ? primeraDisp.precio
      : producto.precio;
const precio = _precioBase !== null ? `$${_precioBase.toFixed(2)}` : tr('tienda.product.consultar');

const dimLabel: Record<string, string> = {
  talla: tr('tienda.product.talla'),
  color: tr('tienda.product.color'),
  edicion: tr('tienda.product.edicion'),
  formato: tr('tienda.product.formato'),
};

type Opcion = { val: string; label: string; hex?: string; disp: boolean };
const opcionesPorDim: Record<string, Opcion[]> = {};
for (const dim of requeridas) {
  let ops: Opcion[] = [];
  if (dim === 'talla')
    ops = tallasDisponibles(catalogo).map((t) => ({
      val: t,
      label: t,
      disp: catalogo.some((v) => v.disponible && v.talla === t),
    }));
  else if (dim === 'color')
    ops = coloresDisponibles(catalogo).map((c) => ({
      val: c.nombre,
      label: c.nombre,
      hex: c.hex,
      disp: catalogo.some((v) => v.disponible && v.color?.nombre === c.nombre),
    }));
  else if (dim === 'edicion')
    ops = edicionesDisponibles(catalogo).map((e) => ({
      val: e,
      label: e,
      disp: catalogo.some((v) => v.disponible && v.edicion === e),
    }));
  else if (dim === 'formato')
    ops = formatosDisponibles(catalogo).map((f) => ({
      val: f,
      label: f,
      disp: catalogo.some((v) => v.disponible && v.formato === f),
    }));
  opcionesPorDim[dim] = ops;
}

const catalogoJson = JSON.stringify(catalogo);
const dimsAttr = requeridas.join(',');
---

<article
  class="group relative flex flex-col bg-white border border-form-border rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-[0_18px_40px_-14px_rgba(0,0,0,0.22)] hover:border-egrem-red focus-within:border-egrem-red"
  data-category={producto.categoria}
  data-price={producto.precio ?? ''}
  data-availability={producto.disponibilidad}
  data-title={producto.titulo}
  data-subtitle={producto.subtitulo}
  data-novedad={esNovedad ? '1' : '0'}
  data-tallas={producto.tallas?.join(',') ?? ''}
  data-colores={producto.colores?.join(',') ?? ''}
  data-ediciones={ediciones.join(',')}
  data-formatos={formatos.join(',')}
  data-tiendas={producto.tiendasConStock?.map((t) => t.id).join(',') ?? ''}
  data-variaciones={producto.variaciones ? JSON.stringify(producto.variaciones) : ''}
  data-catalogo={catalogoJson}
  data-tipo={producto.tipo}
  data-dims={dimsAttr}
  data-titulo={producto.titulo}
  data-directo={directo ? '1' : ''}
>
  <div class="relative aspect-square overflow-hidden bg-egrem-gray-light">
    {
      producto.imagen ? (
        <img
          src={producto.imagen}
          alt={producto.titulo}
          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <span class="icon text-5xl text-egrem-gray/40">confirmation_number</span>
        </div>
      )
    }
    {producto.badge && <span class="tienda-badge">{producto.badge}</span>}
    {
      agotado && (
        <span class="absolute top-3 right-3 z-20 bg-egrem-black/80 text-white text-[10px] font-display font-bold uppercase tracking-wider px-2 py-1 rounded-full">
          {tr('tienda.product.sin_stock')}
        </span>
      )
    }

    {/* Swatches de color (solo si hay más de un color) — seleccionables y bloqueados si sin stock */}
    {
      producto.variaciones && producto.variaciones.filter((v) => v.color).length > 1 && (
        <div class="absolute bottom-3 left-3 flex gap-1.5 flex-wrap z-20" data-color-dots>
          {producto.variaciones.map((v, i) =>
            v.color ? (
              <button
                type="button"
                data-color-dot
                data-index={i}
                data-color={v.color.nombre}
                data-img={v.imagen ?? ''}
                title={v.disponible ? v.color.nombre : `${v.color.nombre} — ${tr('tienda.product.sin_stock')}`}
                aria-label={v.color.nombre}
                disabled={!v.disponible}
                class={`tienda-card__dot w-4 h-4 rounded-full border-2 transition-all duration-150 ${
                  i === 0 && v.disponible ? 'is-active' : 'border-white/70 hover:scale-110'
                }${!v.disponible ? ' is-oos' : ''}`}
                style={{ background: v.color.hex }}
              />
            ) : null,
          )}
        </div>
      )
    }
  </div>

  <div class="p-5 flex flex-col flex-grow">
    <h3 class="font-display font-bold text-[19px] leading-tight text-egrem-black mb-1 line-clamp-1 uppercase tracking-tight">
      {producto.titulo}
    </h3>
    {
      producto.subtitulo && (
        <p class="font-display text-[13px] text-text-secondary mb-4 line-clamp-2 uppercase tracking-wide">
          {producto.subtitulo}
        </p>
      )
    }
    {
      producto.tallas && producto.tallas.length > 0 && (
        <p class="font-display text-[11px] uppercase tracking-wide text-text-secondary mb-3">
          {tr('tienda.list.tallas_disponibles')}: {producto.tallas.join(' · ')}
        </p>
      )
    }
    {
      producto.tipo === 'libro' && ediciones.length > 1 ? (
        <div class="relative z-20 mb-3" data-variant-switcher="edicion">
          <p class="font-display text-[10px] font-bold uppercase tracking-widest text-text-secondary mb-1.5">
            {tr('tienda.product.edicion')}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {ediciones.map((e) => {
              const disp = catalogo.some((v) => v.disponible && v.edicion === e);
              const isActive = primeraDisp?.edicion === e;
              const vImg = catalogo.find((v) => v.edicion === e);
              const img = vImg?.imagenVarianteUrl ?? (vImg as unknown as { imagen?: string })?.imagen ?? '';
              return (
                <button
                  type="button"
                  data-variant-chip
                  data-variant-type="edicion"
                  data-variant-val={e}
                  data-img={img}
                  disabled={!disp}
                  aria-pressed={isActive ? 'true' : 'false'}
                  title={disp ? e : `${e} — ${tr('tienda.product.sin_stock')}`}
                  class={`min-h-[28px] px-3 rounded-full border text-[11px] font-display font-bold uppercase tracking-wide transition-all ${isActive ? 'bg-egrem-black text-white border-egrem-black shadow-sm' : 'bg-white text-text-secondary border-form-border hover:border-egrem-red hover:text-egrem-red'} ${!disp ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}`}
                >
                  {e}
                </button>
              );
            })}
          </div>
        </div>
      ) : ediciones.length > 0 ? (
        <p class="font-display text-[11px] uppercase tracking-wide text-text-secondary mb-3">
          {tr('tienda.product.edicion')}: {ediciones.join(' · ')}
        </p>
      ) : null
    }
    {
      producto.tipo === 'disco' && formatos.length > 1 ? (
        <div class="relative z-20 mb-3" data-variant-switcher="formato">
          <p class="font-display text-[10px] font-bold uppercase tracking-widest text-text-secondary mb-1.5">
            {tr('tienda.product.formato')}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {formatos.map((f) => {
              const disp = catalogo.some((v) => v.disponible && v.formato === f);
              const isActive = primeraDisp?.formato === f;
              const vImg = catalogo.find((v) => v.formato === f);
              const img = vImg?.imagenVarianteUrl ?? (vImg as unknown as { imagen?: string })?.imagen ?? '';
              return (
                <button
                  type="button"
                  data-variant-chip
                  data-variant-type="formato"
                  data-variant-val={f}
                  data-img={img}
                  disabled={!disp}
                  aria-pressed={isActive ? 'true' : 'false'}
                  title={disp ? f : `${f} — ${tr('tienda.product.sin_stock')}`}
                  class={`min-h-[28px] px-3 rounded-full border text-[11px] font-display font-bold uppercase tracking-wide transition-all ${isActive ? 'bg-egrem-black text-white border-egrem-black shadow-sm' : 'bg-white text-text-secondary border-form-border hover:border-egrem-red hover:text-egrem-red'} ${!disp ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}`}
                >
                  {f}
                </button>
              );
            })}
          </div>
        </div>
      ) : formatos.length > 0 ? (
        <p class="font-display text-[11px] uppercase tracking-wide text-text-secondary mb-3">
          {tr('tienda.product.formato')}: {formatos.join(' · ')}
        </p>
      ) : null
    }
    {
      producto.tipo === 'instrumento' && instrumentoVars.length > 0 && (
        <div class="relative z-20 mb-3 space-y-2" data-variant-switcher="instrumento">
          <p class="font-display text-[10px] font-bold uppercase tracking-widest text-text-secondary">
            Variantes · {instrumentoVars.length}
          </p>
          <div class="grid grid-cols-2 gap-1.5">
            {instrumentoVars.map((v, i) => {
              const isActive = instrumentoDefault?.uuid === v.uuid;
              const label = v.materiales ? v.materiales.split(',')[0].trim().slice(0, 14) : `Var. ${i + 1}`;
              const shortLabel = label.length > 14 ? label.slice(0, 12) + '…' : label;
              return (
                <button
                  type="button"
                  data-variant-chip
                  data-variant-type="instrumento"
                  data-variant-idx={String(i)}
                  data-variant-uuid={v.uuid}
                  data-img={v.imagenVarianteUrl ?? (v as unknown as { imagen?: string })?.imagen ?? ''}
                  disabled={!v.disponible}
                  aria-pressed={isActive ? 'true' : 'false'}
                  title={v.disponible ? `${v.materiales ?? ''} · ${v.garantia ?? ''}`.trim() : tr('tienda.product.sin_stock')}
                  class={`group/instr flex flex-col items-start gap-0.5 rounded-xl border px-2.5 py-2 text-left transition-all ${isActive ? 'bg-egrem-black text-white border-egrem-black shadow-md' : 'bg-white text-egrem-black border-form-border hover:border-egrem-red'} ${!v.disponible ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}`}
                >
                  <span class="font-display text-[11px] font-bold leading-none truncate w-full">{shortLabel}</span>
                  <span class={`font-display text-[10px] leading-none ${isActive ? 'text-white/70' : 'text-text-secondary'}`}>
                    {v.precio != null ? `$${v.precio.toFixed(0)}` : ''}
                    {v.disponible ? '' : ' · Agotado'}
                  </span>
                </button>
              );
            })}
          </div>
          <div
            data-instrumento-meta
            class="rounded-xl bg-egrem-gray-light border border-black/5 px-3 py-2.5 transition-all duration-200"
          >
            <p class="font-display text-[11px] font-bold uppercase tracking-widest text-text-secondary mb-1 flex items-center gap-1">
              <span class="icon text-[12px] text-egrem-gold">build</span> Detalle
            </p>
            <p class="instrumento-meta-text font-display text-[12px] leading-snug text-egrem-black line-clamp-2">
              {instrumentoDefault?.materiales ? (
                <>
                  <span class="font-bold">Material:</span> {instrumentoDefault.materiales}
                  {instrumentoDefault.garantia && (
                    <>
                      {' '}
                      <span class="text-text-secondary">·</span> <span class="font-bold">Garantía:</span> {instrumentoDefault.garantia}
                    </>
                  )}
                </>
              ) : (
                <span class="text-text-secondary">Selecciona una variante</span>
              )}
            </p>
          </div>
        </div>
      )
    }
    <div class="mt-auto pt-3">
      <div class="flex items-center justify-between gap-2">
        <span class="font-display text-[22px] text-egrem-red font-bold leading-none" data-product-price>{precio}</span>
        {
          esCompra ? (
            agotado ? (
              <button
                type="button"
                disabled
                aria-label={tr('tienda.product.sin_stock')}
                title={tr('tienda.product.sin_stock')}
                class="tienda-card__cta tienda-card__cta--oos"
              >
                <span class="icon">block</span>
              </button>
            ) : necesitaPopover ? (
              <button
                type="button"
                data-quickbuy-toggle
                data-oos-label={tr('tienda.product.sin_stock')}
                data-error-label={tr('tienda.product.error_breve')}
                data-added-label={tr('tienda.product.agregado')}
                aria-haspopup="true"
                aria-expanded="false"
                aria-label={tr('tienda.quickbuy.anadir')}
                title={tr('tienda.quickbuy.anadir')}
                class="tienda-card__cta"
              >
                <span class="icon">add_shopping_cart</span>
              </button>
            ) : (
              <button
                type="button"
                data-quickbuy-direct
                data-oos-label={tr('tienda.product.sin_stock')}
                data-error-label={tr('tienda.product.error_breve')}
                data-added-label={tr('tienda.product.agregado')}
                data-variacion={primeraDisp?.uuid ?? ''}
                data-sku={primeraDisp?.sku ?? ''}
                data-bundle={producto.tipo}
                data-titulo={producto.titulo}
                aria-label={tr('tienda.quickbuy.anadir')}
                title={tr('tienda.quickbuy.anadir')}
                class="tienda-card__cta"
              >
                <span class="icon">add_shopping_cart</span>
              </button>
            )
          ) : mostrarCta ? (
            <button
              type="button"
              data-add-to-cart
              data-product-id={producto.id}
              data-product-title={producto.titulo}
              aria-label={ctaLabel ?? tr('tienda.list.buy')}
              title={ctaLabel ?? tr('tienda.list.buy')}
              class="tienda-card__cta"
            >
              <span class="icon">add_shopping_cart</span>
            </button>
          ) : detailHref ? (
            <a href={detailHref} class="action-link no-underline">
              {tr('tienda.list.view_details')}
              <span class="icon" style="font-size:16px">arrow_forward</span>
            </a>
          ) : null
        }
      </div>
      <p class="quickbuy-status" data-quickbuy-status role="status" aria-live="polite"></p>
    </div>
  </div>

  {
    necesitaPopover && (
      <div class="quickbuy" data-quickbuy hidden>
        <div class="quickbuy__panel" role="group" aria-label={tr('tienda.quickbuy.anadir')}>
          <div class="quickbuy__head">
            <span class="quickbuy__titulo">{tr('tienda.quickbuy.elige')}</span>
            <button type="button" class="quickbuy__close" data-quickbuy-close aria-label={tr('tienda.quickbuy.cerrar')}>
              <span class="icon text-[18px]">close</span>
            </button>
          </div>
          {requeridas.map((dim) => (
            <div class="quickbuy__row" data-dim-row={dim}>
              <span class="quickbuy__label">{dimLabel[dim]}</span>
              <div class="quickbuy__opts">
                {opcionesPorDim[dim].map((opt) =>
                  dim === 'color' ? (
                    <button
                      type="button"
                      class="quickbuy__swatch"
                      data-dim={dim}
                      data-val={opt.val}
                      style={`--sw:${opt.hex}`}
                      disabled={!opt.disp}
                      aria-pressed="false"
                      aria-label={opt.label}
                      title={opt.label}
                    >
                    </button>
                  ) : (
                    <button
                      type="button"
                      class="quickbuy__chip"
                      data-dim={dim}
                      data-val={opt.val}
                      disabled={!opt.disp}
                      aria-pressed="false"
                    >
                      {opt.label}
                    </button>
                  ),
                )}
              </div>
            </div>
          ))}
          <div class="quickbuy__foot">
            <span class="quickbuy__price" data-quickbuy-price>{precio}</span>
            <button
              type="button"
              class="quickbuy__add"
              data-quickbuy-add
              data-titulo={producto.titulo}
              data-bundle={producto.tipo}
              data-added-label={tr('tienda.product.agregado')}
              data-oos-label={tr('tienda.product.sin_stock')}
              data-error-label={tr('tienda.product.error_breve')}
              disabled
            >
              <span class="icon">add_shopping_cart</span>
              <span>{tr('tienda.quickbuy.anadir')}</span>
            </button>
          </div>
        </div>
      </div>
    )
  }

  {detailHref && esCompra && <a href={detailHref} aria-label={producto.titulo} class="absolute inset-0 z-10" />}
</article>

<style>
  .quickbuy {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 30;
    background: #fff;
    border-top: 1px solid var(--color-egrem-gray-light);
    border-radius: 0 0 1rem 1rem;
    box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.28);
    padding: 0.875rem 1rem 1rem;
    transform: translateY(10px);
    opacity: 0;
    transition:
      transform 0.2s ease-out,
      opacity 0.2s ease-out;
  }
  .quickbuy[hidden] {
    display: none;
  }
  .quickbuy.is-open {
    transform: translateY(0);
    opacity: 1;
  }
  .quickbuy__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.625rem;
  }
  .quickbuy__titulo {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-egrem-black);
  }
  .quickbuy__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    color: var(--color-text-secondary);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .quickbuy__close:hover {
    background: var(--color-egrem-gray-light);
    color: var(--color-egrem-black);
  }
  .quickbuy__row {
    margin-bottom: 0.625rem;
  }
  .quickbuy__label {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    margin-bottom: 0.375rem;
  }
  .quickbuy__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .quickbuy__chip {
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border: 2px solid var(--color-form-border);
    border-radius: 0.75rem;
    background: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .quickbuy__chip:hover:not([disabled]) {
    border-color: var(--color-egrem-red);
  }
  .quickbuy__chip[aria-pressed='true'] {
    border-color: var(--color-egrem-red);
    color: var(--color-egrem-red);
    background: #fff;
  }
  .quickbuy__chip[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .quickbuy__swatch {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    border: 2px solid #fff;
    background: var(--sw);
    box-shadow: 0 0 0 1px var(--color-form-border);
    cursor: pointer;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .quickbuy__swatch[aria-pressed='true'] {
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 3.5px var(--color-egrem-red);
    transform: scale(1.08);
  }
  .quickbuy__swatch[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .quickbuy__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .quickbuy__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-egrem-red);
  }
  .quickbuy__add {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 0.75rem;
    background: var(--color-egrem-red);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8125rem;
