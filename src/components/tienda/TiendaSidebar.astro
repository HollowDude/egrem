---
/**
 * TiendaSidebar.astro — Sidebar de filtros (maqueta Tienda/code.html 646-724).
 * Client-side: los inputs usan data-attrs que el script de tienda.astro lee.
 * Instrumentos y Libros se renderizan pero sin data-sidebar-cat (inertes, 0 productos).
 */
import { useTranslations } from '@/i18n/translations';

interface Props {
  tallas?: string[];
  colores?: string[];
  ediciones?: string[];
  formatos?: string[];
}

const { tallas = [], colores = [], ediciones = [], formatos = [] } = Astro.props;
const lang = Astro.locals.lang;
const tr = useTranslations(lang);

const COLOR_DOT: Record<string, string> = {
  Negro: '#1b1b1b',
  Rojo: '#bc0100',
  Azul: '#1f4e9b',
  Blanco: '#ffffff',
  Verde: '#2e7d32',
  Amarillo: '#f4c20d',
  Gris: '#808080',
};
const dot = (c: string) => COLOR_DOT[c] ?? '#888888';
---

<aside class="w-full lg:w-64 flex-shrink-0" data-tienda-sidebar>
  <div class="lg:sticky lg:top-24">
    <h2 class="font-display font-bold text-egrem-black text-lg uppercase tracking-wide mb-6">
      {tr('tienda.filter.title')}
    </h2>
    <div class="space-y-8">
    <!-- Buscar -->
    <div>
      <h3 class="font-display font-bold text-egrem-black text-xl uppercase mb-4">
        {tr('tienda.filter.search')}
      </h3>
      <div class="relative">
        <input
          type="text"
          data-tienda-search
          placeholder={tr('tienda.filter.search_placeholder')}
          class="w-full bg-white border border-form-border rounded-xl py-2 pl-3 pr-10 text-egrem-black font-display outline-none focus:border-egrem-red focus:ring-1 focus:ring-egrem-red"
        />
        <span class="icon absolute right-3 top-1/2 -translate-y-1/2 text-text-secondary text-[20px]"
          >search</span
        >
      </div>
    </div>

    <!-- Precio -->
    <div class="border-t border-egrem-gray-light pt-7">
      <h3 class="font-display font-bold text-egrem-black text-[15px] uppercase tracking-wide mb-4">
        {tr('tienda.filter.precio')}
      </h3>
      <div class="px-2">
        <input
          type="range"
          min="0"
          max="200"
          value="200"
          data-tienda-price
          class="w-full accent-egrem-red cursor-pointer"
        />
        <div class="flex justify-between text-text-secondary font-display mt-2">
          <span>$0</span>
          <span data-tienda-price-label>$200+</span>
        </div>
      </div>
    </div>

    <!-- Disponibilidad -->
    <div class="border-t border-egrem-gray-light pt-7">
      <h3 class="font-display font-bold text-egrem-black text-[15px] uppercase tracking-wide mb-4">
        {tr('tienda.filter.disponibilidad')}
      </h3>
      <ul class="space-y-2 font-display text-text-secondary">
        <li>
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="checkbox"
              value="stock"
              data-tienda-avail
              class="w-5 h-5 rounded accent-egrem-red cursor-pointer"
            />
            <span class="group-hover:text-egrem-red transition-colors"
              >{tr('tienda.filter.disponibilidad.disponibles')}</span
            >
          </label>
        </li>
        <li>
          <label class="flex items-center gap-3 cursor-pointer group">
            <input
              type="checkbox"
              value="preventa"
              data-tienda-avail
              class="w-5 h-5 rounded accent-egrem-red cursor-pointer"
            />
            <span class="group-hover:text-egrem-red transition-colors"
              >{tr('tienda.filter.disponibilidad.preventa')}</span
            >
          </label>
        </li>
      </ul>
    </div>

    <!-- Filtros dinámicos por categoría: solo se muestran según el chip activo -->
    <div class="hidden border-t border-egrem-gray-light pt-7" data-tienda-filter-group="merchandising">
      {tallas.length > 0 && (
        <div class="mb-8">
          <h3 class="font-display font-bold text-egrem-black text-[15px] uppercase tracking-wide mb-4">
            {tr('tienda.filter.talla')}
          </h3>
          <ul class="grid grid-cols-2 gap-2">
            {tallas.map((t) => (
              <li>
                <button
                  type="button"
                  class="tienda-chip w-full h-11 rounded-xl border-2 border-form-border font-display font-bold text-[15px] text-text-secondary hover:border-egrem-red transition-colors"
                  data-filter-dim="talla"
                  data-filter-val={t}
                  aria-pressed="false"
                >
                  {t}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
      {colores.length > 0 && (
        <div class="mb-8">
          <h3 class="font-display font-bold text-egrem-black text-[15px] uppercase tracking-wide mb-4">
            {tr('tienda.filter.color')}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {colores.map((c) => (
              <li>
                <button
                  type="button"
                  class="tienda-swatch w-8 h-8 rounded-full border-2 border-white"
                  style={`--sw:${dot(c)}`}
                  data-filter-dim="color"
                  data-filter-val={c}
                  aria-pressed="false"
                  aria-label={c}
                  title={c}
                >
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Libro: edición -->
    <div class="hidden border-t border-egrem-gray-light pt-7" data-tienda-filter-group="libro">
      {ediciones.length > 0 && (
        <div class="mb-8">
          <h3 class="font-display font-bold text-egrem-black text-[15px] uppercase tracking-wide mb-4">
            {tr('tienda.product.edicion')}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {ediciones.map((e) => (
              <li>
                <button
                  type="button"
                  class="tienda-chip rounded-xl border-2 border-form-border px-4 h-11 font-display font-bold text-[15px] text-text-secondary hover:border-egrem-red transition-colors"
                  data-filter-dim="edicion"
                  data-filter-val={e}
                  aria-pressed="false"
                >
                  {e}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <!-- Disco: formato -->
    <div class="hidden border-t border-egrem-gray-light pt-7" data-tienda-filter-group="disco">
      {formatos.length > 0 && (
        <div class="mb-8">
          <h3 class="font-display font-bold text-egrem-black text-[15px] uppercase tracking-wide mb-4">
            {tr('tienda.product.formato')}
          </h3>
          <ul class="grid grid-cols-2 gap-2">
            {formatos.map((f) => (
              <li>
                <button
                  type="button"
                  class="tienda-chip w-full h-11 rounded-xl border-2 border-form-border font-display font-bold text-[15px] text-text-secondary hover:border-egrem-red transition-colors"
                  data-filter-dim="formato"
                  data-filter-val={f}
                  aria-pressed="false"
                >
                  {f}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <button
      type="button"
      id="tienda-clear"
      data-tienda-clear
      class="w-full border border-form-border text-egrem-black font-display font-bold text-[13px] uppercase tracking-wider py-2.5 rounded-xl hover:border-egrem-red hover:text-egrem-red transition-colors"
    >
      {tr('tienda.filter.clear')}
    </button>
  </div>
</aside>

<style>
  .tienda-chip[aria-pressed='true'] {
    border-color: var(--color-egrem-red);
    color: #fff;
    background: var(--color-egrem-red);
  }
  .tienda-swatch {
    background: var(--sw);
    box-shadow: 0 0 0 1px var(--color-form-border);
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
    cursor: pointer;
  }
  .tienda-swatch[aria-pressed='true'] {
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 3.5px var(--color-egrem-red);
    transform: scale(1.08);
  }
</style>
