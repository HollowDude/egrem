---
/**
 * AlbumTracklist.astro — Wrapper delgado de la lista de canciones.
 * Toda la interacción vive en Tracklist.tsx (estado compartido, un solo <audio>).
 */
import type { NhTrack } from '@/lib/nodehive';
import type { Lang } from '@/i18n';
import Tracklist from '@/components/ui/Tracklist';

interface Props {
  tracks: NhTrack[];
  lang?: Lang;
}

const { tracks, lang = 'es' } = Astro.props;
---

<Tracklist client:load tracks={tracks} lang={lang} />
