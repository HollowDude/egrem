---
import { useTranslations } from '@/i18n/translations';
import type { Lang } from '@/i18n';

interface Props {
  lang: Lang;
  userName: string;
  currentPath?: string;
}

const { lang, userName, currentPath = '/mi-cuenta' } = Astro.props;
const tr = useTranslations(lang);

interface NavLink {
  href: string;
  icon: string;
  label: string;
}

const links: NavLink[] = [
  { href: '/mi-cuenta', label: tr('auth.dashboard.profile'), icon: 'person' },
  { href: '/mi-cuenta/direcciones', label: tr('auth.dashboard.addresses'), icon: 'location_on' },
  { href: '/mi-cuenta/pedidos', label: tr('auth.dashboard.orders'), icon: 'inventory_2' },
  { href: '#', label: tr('auth.dashboard.tickets'), icon: 'local_activity' },
];

function isActive(href: string, current: string): boolean {
  if (href === '#') return false;
  if (href === '/mi-cuenta') return current === '/mi-cuenta' || current === '/mi-cuenta/';
  return current === href || current.startsWith(href + '/');
}
---

<aside class="w-full md:w-64 shrink-0">
  <div class="pb-6 mb-6 border-b" style="border-color: var(--color-form-border);">
    <h2 class="text-h2 m-0">
      {tr('auth.dashboard.title')}
    </h2>
    <p class="text-small mt-1" style="color: var(--color-text-secondary);">
      {tr('auth.dashboard.welcome').replace('{name}', userName)}
    </p>
  </div>

  <nav class="flex flex-col gap-2">
    {links.map((link) => {
      const active = isActive(link.href, currentPath);
      return (
        <a
          href={link.href}
          class="flex items-center gap-3 px-3 py-3 rounded-r-lg transition-all text-h4 no-underline"
          style={
            active
              ? 'background: var(--color-surface-container); color: var(--color-brand-primary);'
              : 'color: var(--color-text-secondary); border-left: 4px solid transparent;'
          }
          onmouseover={
            !active
              ? "this.style.background='var(--color-surface-container)'; this.style.color='var(--color-brand-primary)'; this.style.borderLeftColor='var(--color-egrem-gold)';"
              : undefined
          }
          onmouseout={
            !active
              ? "this.style.background=''; this.style.color=''; this.style.borderLeftColor='transparent';"
              : undefined
          }
        >
          <span class="icon text-[20px]" style={active ? "font-variation-settings: 'FILL' 1;" : undefined}>
            {link.icon}
          </span>
          {link.label}
        </a>
      );
    })}
  </nav>

  <div class="mt-auto pt-8">
    <button
      id="dashboard-logout-btn"
      class="flex items-center gap-3 px-3 py-3 w-full text-h4 font-bold uppercase no-underline bg-transparent border-none cursor-pointer"
      style="color: var(--color-brand-primary); border-radius: 1rem; transition: all 0.2s ease;"
      onmouseover="this.style.background='rgba(204,0,0,0.06)';"
      onmouseout="this.style.background='transparent';"
    >
      <span class="icon text-[20px]">logout</span>
      {tr('auth.dashboard.logout')}
    </button>
  </div>
</aside>

<script>
  document.getElementById('dashboard-logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({}),
    });
    window.location.href = '/login';
  });
</script>
