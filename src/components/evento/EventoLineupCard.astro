---
/**
 * EventoLineupCard.astro — Tarjeta de artista invitado con su rol en el evento.
 */
import type { NhEventoLineupArtista } from '@/lib/nodehive';

interface Props {
  artista: NhEventoLineupArtista;
}

const { artista } = Astro.props;
const img = artista.artista.imagen;
---

<a
  href={artista.artista.href}
  class="group flex items-center gap-4 bg-egrem-gray-light/60 border border-egrem-gray/20 rounded-xl p-4 no-underline hover:border-egrem-gold hover:shadow-sm transition-all"
>
  {
    img?.url ? (
      <img
        src={img.url}
        alt={img.alt || artista.artista.name}
        class="w-16 h-16 object-cover rounded-lg grayscale group-hover:grayscale-0 transition-all duration-300 shrink-0"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-16 h-16 bg-egrem-gray-light border border-egrem-gray/20 rounded-lg flex items-center justify-center shrink-0">
        <span class="text-2xl text-egrem-gray/50" style="font-family: 'Material Symbols Outlined';">
          person
        </span>
      </div>
    )
  }
  <div class="min-w-0">
    <p
      class="font-display font-bold text-[10px] uppercase tracking-widest text-egrem-gold m-0 mb-0.5"
    >
      {artista.rol}
    </p>
    <h3
      class="font-display font-bold text-body text-egrem-black m-0 group-hover:text-egrem-red transition-colors truncate"
    >
      {artista.artista.name}
    </h3>
  </div>
</a>
