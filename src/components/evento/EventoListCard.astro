---
/**
 * EventoListCard.astro — Tarjeta de producto/entrada estilo maqueta EGREM.
 * Imagen con padding, badge de estado arriba-izquierda, precio en gold,
 * botón redondo de agregar (icono add_shopping_cart).
 */
import type { NhEventoListItem } from '@/lib/nodehive';
import type { Lang } from '@/i18n';
import { useTranslations } from '@/i18n/translations';

interface Props {
  evento: NhEventoListItem;
  lang?: Lang;
  ctaLabel?: string;
}

const { evento, lang = 'es', ctaLabel } = Astro.props;
const tr = useTranslations(lang);

function formatFecha(fecha: string): string {
  const d = new Date(`${fecha}T12:00:00`);
  if (Number.isNaN(d.getTime())) return fecha;
  return d.toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

const fechaDisplay =
  evento.fechaFin && evento.fechaFin !== evento.fechaInicio
    ? `${formatFecha(evento.fechaInicio)} - ${formatFecha(evento.fechaFin)}`
    : formatFecha(evento.fechaInicio);

const subtitulo = evento.artistas.length
  ? evento.artistas.join(', ')
  : evento.lugarTexto;

const precio = evento.precioDesde !== null ? `$${evento.precioDesde.toFixed(2)}` : null;
---

<article class="group flex flex-col bg-white border border-form-border rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-egrem-red">
  <div class="relative aspect-square overflow-hidden bg-egrem-gray-light p-4">
    {evento.thumbnail?.url ? (
      <img
        src={evento.thumbnail.url}
        alt={evento.thumbnail.alt || evento.title}
        class="w-full h-full object-cover shadow-sm transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span class="text-5xl text-egrem-gray/40" style="font-family: 'Material Symbols Outlined';">confirmation_number</span>
      </div>
    )}
    {evento.agotado && <span class="tienda-badge">{tr('evento.list.sold_out')}</span>}
  </div>

  <div class="p-6 flex flex-col flex-grow">
    <h3 class="font-display font-bold text-[20px] text-egrem-black mb-1 line-clamp-1 uppercase">
      {evento.title}
    </h3>
    {subtitulo && (
      <p class="font-display text-sm text-text-secondary mb-4 line-clamp-2 uppercase">{subtitulo}</p>
    )}
    <div class="mt-auto flex items-center justify-between">
      {precio ? (
        <span class="font-display text-[22px] text-egrem-gold font-bold">{precio}</span>
      ) : (
        <span></span>
      )}
      <a
        href={evento.href}
        aria-label={ctaLabel ?? tr('tienda.list.buy')}
        title={ctaLabel ?? tr('tienda.list.buy')}
        class="bg-egrem-red text-white p-2 rounded-2xl hover:bg-egrem-red-dark transition-colors focus:ring-2 focus:ring-egrem-gold flex items-center justify-center no-underline"
      >
        <span style="font-family: 'Material Symbols Outlined';" class="text-[20px]">add_shopping_cart</span>
      </a>
    </div>
  </div>
</article>
